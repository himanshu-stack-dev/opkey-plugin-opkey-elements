{% set diagonalColor = design.theme_color.color == 'purple' ? '4EC7D4' : 'be72f8' %}
{% set selected_style = design.styles.style|default('style-1') %}
<style>
@media (min-width: 1024px) {
  .breakdance .autogenerated-bce-ctaemailbar .cta-diagonal::before {
   background: url('data:image/svg+xml;utf8,<svg width="54" height="200" viewBox="0 0 54 200" fill="none" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="fadeLine" x1="54" y1="0" x2="0" y2="200" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="%23{{ diagonalColor }}" stop-opacity="1"/><stop offset="0.7" stop-color="%23{{ diagonalColor }}" stop-opacity="0.2"/><stop offset="1" stop-color="%23fff" stop-opacity="0"/></linearGradient></defs><line x1="54" y1="0" x2="0" y2="200" stroke="url(%23fadeLine)" stroke-width="3" stroke-linecap="butt"/></svg>') no-repeat left center;
    background-size: contain;
  }
}
</style>

<div class="module-container cta-email-bar--{{ selected_style }}">
  {% if selected_style == 'style-2' %}
    <div class="cta-style2-wrap">
      <div class="cta-style2-card">
        {% set heading = content.heading.text %}
        {% if heading %}
          <h2>{{ heading }}</h2>
        {% endif %}

        {% set body = content.content.text %}
        {% if body %}
          <p class="cta-style2-sub">{{ body }}</p>
        {% endif %}

        {% set eyebrow = content.eyebrow.text %}
        {% if eyebrow %}
          <p class="cta-style2-sub2">{{ eyebrow }}</p>
        {% endif %}

        {% set email_embed = content.shortcode.full_shortcode %}
        {% if email_embed %}
          <div class="demo-gradient-border-wrapper cta-style2-form-wrap">%%SSR%%</div>
        {% endif %}
      </div>
    </div>
  {% else %}
    <div class="gradient-wrapper">
      <div class="module-text">
        {# EYEBROW #}
        {% set eyebrow = content.eyebrow.text %}
        {% if eyebrow %}
          <div class="eyebrow">{{ eyebrow }}</div>
        {% endif %}
        {# HEADING #}
        {% set heading = content.heading.text  %}
        {% if heading %}
          <h2>{{ heading }}</h2>
        {% endif %}
        {# BODY #}
        {% set body = content.content.text  %}
        {% if body %}
          <p>{{ body }}</p>
        {% endif %}
      </div>
      {# Set the SVG gradient color based on theme #}
      {% set diagonalColor = design.theme_color.color == 'purple' ? '4EC7D4' : 'be72f8' %}
      <div class="cta-diagonal"></div>
      {# EMAIL #}
      {% set email_embed = content.shortcode.full_shortcode  %}
      {% if email_embed %}
        <div class="demo-gradient-border-wrapper">%%SSR%%</div>
      {% endif %}
    </div>
  {% endif %}
</div>