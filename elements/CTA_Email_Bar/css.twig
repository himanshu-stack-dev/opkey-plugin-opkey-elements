/* PADDING */
{% if design.remove_padding.remove_top and design.remove_padding.remove_bottom %}
    %%SELECTOR%% { padding-top: 0 !important; padding-bottom: 0 !important; }
{% elseif design.remove_padding.remove_top %}
    %%SELECTOR%% { padding-top: 0 !important; }
{% elseif design.remove_padding.remove_bottom %}
    %%SELECTOR%% { padding-bottom: 0 !important; }
{% endif %}

/* THEME */


{% if design.theme_color.color == 'purple' %}
    %%SELECTOR%%, %%SELECTOR%% .gradient-wrapper, %%SELECTOR%% .cta-diagonal::after { background: #190D2C; color: #fff; }
	%%SELECTOR%% .module-container { background: linear-gradient(90deg, #190D2C 0%, #4EC7D4 100%); }
    %%SELECTOR%% h2 { color: #fff; }
	%%SELECTOR%% p { color:#CEDDDF; }
	%%SELECTOR%% .eyebrow:before, %%SELECTOR%% .eyebrow:after { 	filter:invert(100); }
	.breakdance-builder-active .autogenerated-bce-ctaemailbar .cta-diagonal::before {
  filter: invert(68%) sepia(15%) saturate(1365%) hue-rotate(112deg) brightness(94%) contrast(93%)!important;
}
    /* FORM */
	%%SELECTOR%% .demo-gradient-border-wrapper { background: linear-gradient(90deg, #190D2C 0%, #4EC7D4 100%);}
	%%SELECTOR%% .hbspt-form { background:#190D2C; }
	%%SELECTOR%% .hs-form input,
	%%SELECTOR%% .hs-form input::placeholder { color:#fff; }
	%%SELECTOR%% .hs_submit::before { background:#81F0FD; }
	%%SELECTOR%% .hs_submit .actions::before,
	%%SELECTOR%% .hs_submit .actions::before{ background:#000; }
	%%SELECTOR%% .hs_submit .actions::after { border-top: .125rem solid #000;
  border-right: .125rem solid #000; }
	%%SELECTOR%% .hs_submit:hover .primary { color:#000; }
    /* MOBILE: Primary button text color black */
    @media (max-width: 1023px) {
      %%SELECTOR%% .button-atom--primary .button-atom__text {
        color: #000 !important;
      }
      %%SELECTOR%% .opkey-link-text .button-atom__text { color: #fff !important; }
    }
	/* EMAIL */
    %%SELECTOR%% .demo-gradient-border-wrapper { background: linear-gradient(90deg, #190D2C 0%, #81F0FD 100%); }
    %%SELECTOR%% .demo-gradient-form, %%SELECTOR%% .demo-gradient-form input { background:#190D2C; }
    %%SELECTOR%% .demo-gradient-form input,%%SELECTOR%% .demo-gradient-form input::placeholder { color:white; }
    %%SELECTOR%% .demo-gradient-form button span { color:#81F0FD; }
    %%SELECTOR%% .demo-gradient-form button span::after { border-top: .125rem solid #190D2C; border-right: .125rem solid #190D2C;}
{% elseif design.theme_color.color == 'light-gray' %}
	%%SELECTOR%% .module-container { background: linear-gradient(90deg, #EDF7F9 0%, #be72f8 100%); }
	%%SELECTOR%%, %%SELECTOR%% .gradient-wrapper { background: #EDF7F9; }
{% endif %}
