<div class="module-container">
  {# EYEBROW #}
  {% set eyebrow = content.eyebrow.text %}
  {% if eyebrow %}
    <div class="eyebrow">{{ eyebrow }}</div>
  {% endif %}

  {# HEADING #}
  {% set heading = content.heading.text %}
  {% if heading %}
    <h2>{{ heading }}</h2>
  {% endif %}

  {# SUBHEAD #}
  {% set subhead = content.subhead.text %}
  {% if subhead %}
    <h4>{{ subhead }}</h4>
  {% endif %}

  {# BODY #}
  {% set body = content.content.text %}
  {% if body %}
    <p>{{ body }}</p>
  {% endif %}

  {# BUTTONS #}
  {% set pb = content.buttons.primary_button|default({}) %}
  {% set sb = content.buttons.secondary_button|default({}) %}

  {% if pb.text|default('')|trim or sb.text|default('')|trim %}
    <div class="content-module module-buttons">
      {% if pb.text|default('')|trim %}
        {{ macros.atomV1ButtonHtml(
             pb,
             'opkey-primary',
             path.to.button_design_preset_section,
             'primary',
             pb.text|trim
           ) }}
      {% endif %}
      {% if sb.text|default('')|trim %}
        {{ macros.atomV1ButtonHtml(
             sb,
             'opkey-link-text',
             path.to.button_design_preset_section,
             'secondary',
             sb.text|trim
           ) }}
      {% endif %}
    </div>
  {% endif %}

  <div class="accordion-module">
    {# Only render if the user has added at least one item #}
    {% if content.settings is defined 
          and content.settings.items is defined 
          and content.settings.items|length > 0 %}
      
      {% for item in content.settings.items %}
        <div class="bde-faq__item">
          {# Question button #}
          <{{ design.typography.title_tag|default('h3') }} class="bde-faq__title-tag">
            <button
              id="bde-faq-{{ content.id }}-button-{{ loop.index }}"
              aria-expanded="false"
              aria-controls="bde-faq-{{ content.id }}-{{ loop.index }}"
              class="bde-faq__question js-faq-item"
            >
              <h3>{{ item.question }}</h3>
              <div aria-hidden="true" class="bde-faq__icon bde-faq__icon--rotate">
                <img src="/wp-content/uploads/2025/07/Dropdown-Arrow.svg" alt="" aria-hidden="true" />
              </div>
            </button>
          </{{ design.typography.title_tag|default('h3') }}>

          {# Answer panel #}
          <div
            role="region"
            aria-labelledby="bde-faq-{{ content.id }}-button-{{ loop.index }}"
            id="bde-faq-{{ content.id }}-{{ loop.index }}"
            class="bde-faq__answer"
          >
            <div class="bde-faq__answer-content">
              <div class="breakdance-rich-text-styles">
                {{ item.answer }}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}

    {% endif %}
  </div>
</div>