/* LAYOUT: Container (Bootstrap-style) when "Container" is selected */
{% if design.layout.width|default('full_width') == 'container' %}
%%SELECTOR%% .container {
  width: 100%;
  margin-left: auto;
  margin-right: auto;
  padding-left: 12px;
  padding-right: 12px;
  box-sizing: border-box;
}
@media (min-width: 576px) {
  %%SELECTOR%% .container { max-width: 540px; }
}
@media (min-width: 768px) {
  %%SELECTOR%% .container { max-width: 720px; padding-left: 15px; padding-right: 15px; }
}
@media (min-width: 992px) {
  %%SELECTOR%% .container { max-width: 960px; }
}
@media (min-width: 1200px) {
  %%SELECTOR%% .container { max-width: 1140px; }
}
@media (min-width: 1400px) {
  %%SELECTOR%% .container { max-width: 1320px; padding-left: 15px; padding-right: 15px; }
}
{% endif %}

/* SLIDER SETTINGS: Speed (duration in seconds) and Autoplay */
{% set slider_speed = design.slider.settings.speed.number|default(design.slider.settings.speed|default(525)) %}
%%SELECTOR%% .un-logo-bar__marquee-content.carousel-type__marquee {
  --marquee-duration: {{ slider_speed }}s;
}
%%SELECTOR%% .un-logo-bar__marquee-content.carousel-type__marquee.marquee-paused {
  animation-play-state: paused;
}

/* PADDING */
{% if design.remove_padding.remove_top and design.remove_padding.remove_bottom %}
  %%SELECTOR%% { padding-top: 0 !important; padding-bottom: 0 !important; }
{% elseif design.remove_padding.remove_top %}
  %%SELECTOR%% { padding-top: 0 !important; }
{% elseif design.remove_padding.remove_bottom %}
  %%SELECTOR%% { padding-bottom: 0 !important; }
{% endif %}

/* THEME */
{% if design.theme_color.color == 'purple' %}
  %%SELECTOR%% { background: #190D2C!important; color: #fff; }
  %%SELECTOR%% h2, %%SELECTOR%% h4 { color: #fff; }
  %%SELECTOR%% p, %%SELECTOR%% ul, %%SELECTOR%% ol { color: #CEDDDF; }
  %%SELECTOR%% .eyebrow:before, %%SELECTOR%% .eyebrow:after { filter: invert(100); }

  /* PRIMARY BUTTON */
  %%SELECTOR%% .button-atom--primary::before { background: #81F0FD !important; }
  %%SELECTOR%% .button-atom--primary .button-atom__text { color: #81F0FD !important; }
  %%SELECTOR%% .button-atom--primary:hover .button-atom__text,
  %%SELECTOR%% .button-atom--primary:focus .button-atom__text { color: #000 !important; }
  %%SELECTOR%% .button-atom--primary .button-atom__text::before { background: #000; }
  %%SELECTOR%% .button-atom--primary .button-atom__text::after {
    border-top: .125rem solid #000;
    border-right: .125rem solid #000;
  }

  /* TEXT LINK BUTTON */
  %%SELECTOR%% .opkey-link-text .button-atom__text { color: #fff !important; }
  %%SELECTOR%% .opkey-link-text .button-atom__text::before,
  %%SELECTOR%% .opkey-link-text .button-atom__text::after {
    border-top: 2px solid #fff !important;
    border-right: 2px solid #fff !important;
  }
  %%SELECTOR%% .opkey-link-text:hover .button-atom__text,
  %%SELECTOR%% .opkey-link-text .button-atom__text:hover,
  %%SELECTOR%% .opkey-link-text .button-atom__text:focus { color: #81F0FD !important; }
  %%SELECTOR%% .opkey-link-text .button-atom__text:hover::before,
  %%SELECTOR%% .opkey-link-text .button-atom__text:focus::before,
  %%SELECTOR%% .opkey-link-text .button-atom__text:hover::after,
  %%SELECTOR%% .opkey-link-text .button-atom__text:focus::after {
    border-top: 2px solid #81F0FD !important;
    border-right: 2px solid #81F0FD !important;
  }

  /* MOBILE */
  @media (max-width: 1023px) {
    %%SELECTOR%% .button-atom--primary .button-atom__text { color: #fff !important; }
    %%SELECTOR%% .opkey-link-text .button-atom__text { color: #fff !important; }
  }
{% elseif design.theme_color.color == 'light-gray' %}
  %%SELECTOR%% { background: #EDF7F9!important; }
{% elseif design.theme_color.color == 'white' %}
  %%SELECTOR%% { background: #fff!important; }
{% elseif design.theme_color.color == 'transparent' %}
  %%SELECTOR%% { background: transparent; }
{% else %}
	%%SELECTOR%% { background: transparent; }
{% endif %}