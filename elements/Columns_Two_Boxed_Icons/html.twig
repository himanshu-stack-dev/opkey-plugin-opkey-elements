<div class="module-container">
  <div class="module-columns module-text">
    {# EYEBROW #}
    {% set eyebrow = content.eyebrow.text %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}

    {# HEADING #}
    {% set heading = content.heading.text  %}
    {% if heading %}
      <h2>{{ heading }}</h2>
    {% endif %}

    {# SUBHEAD #}
    {% set subhead = content.subhead.text  %}
    {% if subhead %}
      <h4>{{ subhead }}</h4>
    {% endif %}

    {# BODY #}
    {% set body = content.content.text  %}
    {% if body %}
      <p>{{ body }}</p>
    {% endif %}

    {# BUTTONS #}
    {% set pb = content.buttons.primary_button|default({}) %}
    {% set sb = content.buttons.secondary_button|default({}) %}

    {% if pb.text|default('')|trim or sb.text|default('')|trim %}
      <div class="content-module module-buttons">
        {% if pb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               pb,
               'opkey-primary',
               path.to.button_design_preset_section,
               'primary',
               pb.text|trim
             ) }}
        {% endif %}
        {% if sb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               sb,
               'opkey-link-text',
               path.to.button_design_preset_section,
               'secondary',
               sb.text|trim
             ) }}
        {% endif %}
      </div>
    {% endif %}
  </div>

  {# COLUMNS #}
{# Fallback/default columns – used ONLY in Builder for preview #}
{% set default_columns = [
  {
    icon: null,
    heading: "Lorem ipsum dolor sit",
    content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
    button: { text: "Learn more", url: "#" }
  },
  {
    icon: null,
    heading: "Lorem ipsum dolor sit",
    content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
    button: { text: "Learn more", url: "#" }
  },
  {
    icon: null,
    heading: "Lorem ipsum dolor sit",
    content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
    button: { text: "Learn more", url: "#" }
  },
  {
    icon: null,
    heading: "Lorem ipsum dolor sit",
    content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
    button: { text: "Learn more", url: "#" }
  }
] %}

{# Use real columns if present; otherwise show defaults only in Builder #}
{% set has_real_cols = content.columns.column|length > 0 %}
{% set columns = has_real_cols ? content.columns.column : (isBuilder ? default_columns : []) %}

<div class="columns">
  {% for item in columns %}
    <div class="column">
      <div class="icon">
        {% if item.icon %}
          {{ macros.image(item.icon, content.content.size, alt, lazyLoad) }}
        {% else %}
          <img src="/wp-content/uploads/2025/06/icon-robot.svg" alt="Placeholder image" class="breakdance-image-object" style="width:100%; height:auto;" />
        {% endif %}
      </div>

      {# Heading #}
      {% if item.heading %}<h3>{{ item.heading }}</h3>{% endif %}

      {# Body #}
      {% if item.content %}<p>{{ item.content }}</p>{% endif %}

      {# BUTTON — only render if actually populated (no defaults) #}
      {% set btn = item.button is defined ? item.button : null %}
      {% set btn_text = btn and (btn.text|default('')|trim) ? btn.text|trim : '' %}
      {% set btn_url  = btn and (btn.url|default('')|trim)  ? btn.url|trim  : '' %}

      {% if btn_text and btn_url %}
        <div class="content-module module-buttons">
          {{ macros.atomV1ButtonHtml(
              btn,
              'opkey-link-text',
              path.to.button_design_preset_section,
              'secondary',
              btn_text
          ) }}
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>
</div>