<div class="module-container">
  <div class="module-columns module-text">
    {# EYEBROW #}
    {% set eyebrow = content.eyebrow.text %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}

    {# HEADING #}
    {% set heading = content.heading.text  %}
    {% if heading %}
      <h2>{{ heading }}</h2>
    {% endif %}

    {# SUBHEAD #}
    {% set subhead = content.subhead.text  %}
    {% if subhead %}
      <h4>{{ subhead }}</h4>
    {% endif %}

    {# BODY #}
    {% set body = content.content.text  %}
    {% if body %}
      <p>{{ body }}</p>
    {% endif %}

    {# BUTTONS #}
    {% set pb = content.buttons.primary_button|default({}) %}
    {% set sb = content.buttons.secondary_button|default({}) %}

    {% if pb.text|default('')|trim or sb.text|default('')|trim %}
      <div class="content-module module-buttons">
        {% if pb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               pb,
               'opkey-primary',
               path.to.button_design_preset_section,
               'primary',
               pb.text|trim
             ) }}
        {% endif %}
        {% if sb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               sb,
               'opkey-link-text',
               path.to.button_design_preset_section,
               'secondary',
               sb.text|trim
             ) }}
        {% endif %}
      </div>
    {% endif %}
  </div>

  {# COLUMNS #}  
  {# Fallback/default columns #}
  {% set default_columns = [
    {
      icon: null,
      heading: "Lorem ipsum dolor sit",
      content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
      button: { text: "Learn more", url: "#" }
    },
    {
      icon: null,
      heading: "Lorem ipsum dolor sit",
      content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
      button: { text: "Learn more", url: "#" }
    },
    {
      icon: null,
      heading: "Lorem ipsum dolor sit",
      content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
      button: { text: "Learn more", url: "#" }
    },
    {
      icon: null,
      heading: "Lorem ipsum dolor sit",
      content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
      button: { text: "Learn more", url: "#" }
    },
    {
      icon: null,
      heading: "Lorem ipsum dolor sit",
      content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
      button: { text: "Learn more", url: "#" }
    },
    {
      icon: null,
      heading: "Lorem ipsum dolor sit",
      content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
      button: { text: "Learn more", url: "#" }
    }
  ] %}

  {# Use columns if they exist, otherwise fallback to two defaults #}
  {% set using_default = content.columns.column | length == 0 %}
  {% set columns = using_default ? default_columns : content.columns.column %}

  <div class="columns">
    {% for item in columns %}
      <div class="column">
        <div class="icon">
          {% if item.icon %}
            {{ macros.image(item.icon, content.content.size, alt, lazyLoad) }}
          {% else %}
            <img src="/wp-content/uploads/2025/06/icon-robot.svg" alt="Placeholder image" class="breakdance-image-object" style="width:100%; height:auto;" />
          {% endif %}
        </div>

        {# Heading fallback #}
        <h3>{{ item.heading  }}</h3>

        {# Body fallback #}
        <p>{{ item.content  }}</p>

        {# BUTTON with fallback #}
        {% if (item.button is defined and item.button.text|length > 0) or using_default %}
          <div class="content-module module-buttons">
            {{ macros.atomV1ButtonHtml(
                item.button is defined ? item.button : { text: 'Learn more', url: '#' },
                'opkey-link-text',
                path.to.button_design_preset_section,
                'secondary',
                item.button.text is defined and item.button.text|length > 0 
                  ? item.button.text 
                  : 'Learn more'
            ) }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>