<div class="module-container">
  <div class="module-columns module-text">
    {# EYEBROW #}
    {% set eyebrow = content.eyebrow.text | default('LOREM IPSUM DOLOR') %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}

    {# HEADING #}
    {% set heading = content.heading.text | default('Lorem ipsum dolor sit amet') %}
    {% if heading %}
      <h2>{{ heading }}</h2>
    {% endif %}

    {# SUBHEAD #}
    {% set subhead = content.subhead.text | default('Lorem ipsum dolor sit amet consectetur adipiscing elit') %}
    {% if subhead %}
      <h4>{{ subhead }}</h4>
    {% endif %}

    {# BODY #}
    {% set body = content.content.text | default('Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco.') %}
    {% if body %}
      <p>{{ body }}</p>
    {% endif %}

    {# BUTTONS #}
    {% set remove_buttons = content.buttons.remove_ is defined and content.buttons.remove_ == true %}

    {% if not remove_buttons %}
      {% set primary_button = content.buttons.primary_button.text ?? 'Contact sales' %}
      {% set has_secondary = content.buttons.secondary_button is defined and content.buttons.secondary_button.text is defined %}
      {% set secondary_button_obj = has_secondary ? content.buttons.secondary_button : { text: 'Learn more', url: '#' } %}
      {% set secondary_button_label = secondary_button_obj.text ?? 'Learn more' %}

      {% if primary_button or secondary_button_label %}
        <div class="content-module module-buttons">
          {% if primary_button %}
            {{ macros.atomV1ButtonHtml(content.buttons.primary_button, 'opkey-primary', path.to.button_design_preset_section, 'primary', primary_button) }}
          {% endif %}
          {% if secondary_button_label %}
            {{ macros.atomV1ButtonHtml(secondary_button_obj, 'opkey-link-text', path.to.button_design_preset_section, 'secondary', secondary_button_label) }}
          {% endif %}
        </div>
      {% endif %}
    {% endif %}
  </div>

  {# COLUMNS #}  
  {% set default_columns = [
    {
      headshot: "/wp-content/uploads/2025/07/Placeholder.png",
      name: "Pankaj Goel",
      title: "Co-Founder & CEO",
      linkedin: { text: "Co-Founder & CEO", url: "#" }
    },
    {
      headshot: "/wp-content/uploads/2025/07/Placeholder-1.png",
      name: "Avinash Tiwari",
      title: "Co-Founder & Head of Opkey Mobile",
      linkedin: { text: "Co-Founder & Head of Opkey Mobile", url: "#" }
    },
    {
      headshot: "/wp-content/uploads/2025/07/Placeholder-2.png",
      name: "Lalit Jain",
      title: "Co-Founder",
      linkedin: { text: "Co-Founder", url: "#" }
    },
    {
      headshot: "/wp-content/uploads/2025/07/Placeholder-3.png",
      name: "Linda Chen",
      title: "Chief Marketing & Alliances Officer",
      linkedin: { text: "Chief Marketing & Alliances Officer", url: "#" }
    },
    {
      headshot: "/wp-content/uploads/2025/07/Placeholder-5.png",
      name: "Grae Gray",
      title: "Executive VP of Innovation & Excellence",
      linkedin: { text: "Executive VP of Innovation & Excellence", url: "#" }
    },
    {
      headshot: "/wp-content/uploads/2025/07/Placeholder-4.png",
      name: "Ram Subramanian",
      title: "Executive VP of Enterprise Solutions",
      linkedin: { text: "Executive VP of Enterprise Solutions", url: "#" }
    },
    {
      headshot: "/wp-content/uploads/2025/07/Placeholder-6.png",
      name: "Dimpy Sharma",
      title: "VP of Product Solutions",
      linkedin: { text: "VP of Product Solutions", url: "#" }
    },
    {
      headshot: "/wp-content/uploads/2025/07/Placeholder-7.png",
      name: "Julian Andronic",
      title: "VP of Sales",
      linkedin: { text: "VP of Sales", url: "#" }
    }
  ] %}

  {# THIS is the crucial fix: #}
  {% set has_columns = content.columns is defined and content.columns.column is defined and content.columns.column|length > 0 %}
  {% set columns = has_columns ? content.columns.column : default_columns %}

  <div class="columns team-grid">
    {% for item in columns %}
      <div class="column">
        <div class="column-container">
          <div class="column-image" style="margin-bottom: 1em;">
            {% if item.headshot is defined and item.headshot %}
              {% if item.headshot.url is defined %}
                <img src="{{ item.headshot.url }}" alt="{{ item.headshot.alt|default(item.name|default('Team member')) }}" class="breakdance-image-object" style="width:100%; height:auto; border-radius: 999px 999px 16px 16px / 999px 999px 28px 28px; background: #eaf8fa;" />
              {% else %}
                <img src="{{ item.headshot }}" alt="{{ item.name|default('Team member') }}" class="breakdance-image-object" style="width:100%; height:auto; border-radius: 999px 999px 16px 16px / 999px 999px 28px 28px; background: #eaf8fa;" />
              {% endif %}
            {% else %}
              <img src="/wp-content/uploads/2025/07/Placeholder.png" alt="Placeholder image" class="breakdance-image-object" style="width:100%; height:auto; border-radius: 999px 999px 16px 16px / 999px 999px 28px 28px; background: #eaf8fa;" />
            {% endif %}
          </div>
          <div class="column-text">
            <h4>
              {{ item.name is defined and item.name|trim|length > 0
                ? item.name
                : 'Lorem ipsum dolor sit amet' }}
            </h4>
            <div class="linkedin-row">
              {% if item.linkedin is defined and item.linkedin.url is defined %}
                <a href="{{ item.linkedin.url|default('#') }}" target="_blank" rel="noopener" aria-label="LinkedIn: {{ item.name|default('Team member') }}">
                  <img src="/wp-content/uploads/2025/07/Social_LinkedIn.svg" alt="" style="width:19px; height:19px;" />
                </a>
              {% endif %}
              <span>
                {{ item.title is defined and item.title|trim|length > 0
                  ? item.title
                  : 'Lorem ipsum dolor sit amet' }}
              </span>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>