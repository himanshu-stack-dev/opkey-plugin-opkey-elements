{% set defaults = {
  quote: {
    title: '',
    text: '',
    headshot: '/wp-content/plugins/opkey-elements/assets/Placeholder-headshot-small.png',
    name: '',
    role_company: '',
    button: { text: '', url: '' }
  }
} %}

<div class="module-container">
  <div class="module-quote">
    <div class="quote-content">
      <div class="gradient-wrapper">

        {% set slides = (content.quotes.slides is defined and content.quotes.slides|length > 0)
          ? content.quotes.slides
          : [defaults.quote] %}
        {% set slide_count = slides|length %}

        <div class="breakdance-swiper-wrapper" data-swiper-id="%%ID%%">
          <div class="swiper swiper-%%UNIQUESLUG%%">
            <div class="swiper-wrapper">
              {% for item in slides %}
                {% set is_fallback = item.text|default('') == defaults.quote.text %}
                {% set raw_link = item.link_to_case_study|default({}) %}
                {% set fallback_link = {
                  text: defaults.quote.button.text,
                  link: { url: defaults.quote.button.url, new_window: false, nofollow: false }
                } %}
                {% set linkObj = is_fallback ? fallback_link : raw_link %}
                {% set label = linkObj.text|default('')|trim %}

                <div class="swiper-slide">
                  <div class="bde-basicslider__slide">
                    <div class="bde-basicslider__content">
                      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin:0 auto 24px;opacity:.2;color:#a956ff"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21z"></path><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path></svg>
                      <h4 class="bde-basicslider__title">{{ item.title }}</h4>
                      <div class="bde-basicslider__text">{{ item.text }}</div>

                      <div class="quote-attribution">
                        <div class="quote-headshot">
                          {% if item.headshot is defined and item.headshot is not empty and (item.headshot.url is defined or item.headshot.ID is defined or item.headshot.id is defined) %}
                            {{ macros.image(item.headshot, content.content.size, alt, lazyLoad) }}
                          {% else %}
                            <img src="{{ defaults.quote.headshot }}" alt="Placeholder headshot" loading="lazy">
                          {% endif %}
                        </div>
                        <div class="name-company">
                          <div class="name">{{ item.name }}</div>
                          <div class="company">{{ item.role_company }}</div>
                        </div>
                      </div>

                      {% if label %}
                        {{ macros.atomV1ButtonHtml(
                          linkObj,
                          'bde-basicslider__button opkey-link-text',
                          path.to.button_design_preset_section,
                          'text',
                          label
                        ) }}
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>

    {% if slide_count > 1 %}
      <div class="slider-navigation" aria-label="Carousel controls">
        <button
          type="button"
          class="swiper-button-prev swiper-button-prev-%%UNIQUESLUG%% custom-nav-btn"
          aria-label="Previous slide">
        </button>

        <div class="slider-nav-progress" aria-hidden="true">
          <span class="slider-nav-progress-fill"></span>
        </div>

        <button
          type="button"
          class="swiper-button-next swiper-button-next-%%UNIQUESLUG%% custom-nav-btn"
          aria-label="Next slide">
        </button>
      </div>
    {% endif %}
  </div>
</div>
