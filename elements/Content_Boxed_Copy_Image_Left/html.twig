{# Content + Boxed Copy + Media Left — cleaned + wired to controls #}

{% set in_builder = (isBuilder is defined and isBuilder) %}

{# -------- MAIN COPY -------- #}
{% set eyebrow = content.eyebrow.text|default('') %}
{% set heading = content.heading.text|default('') %}
{% set subhead = content.subhead.text|default('') %}
{% set body    = content.content.text|default('') %}

{% set pb = content.buttons.primary_button|default({}) %}
{% set sb = content.buttons.secondary_button|default({}) %}
{% set has_main_btns = pb.text|default('')|trim or sb.text|default('')|trim %}
{% set has_main_text = eyebrow or heading or subhead or (body|striptags|trim) %}

{# -------- BOXED COPY -------- #}
{% set bc_eyebrow = content.boxed_copy.bc_eyebrow|default('') %}
{% set bc_heading = content.boxed_copy.bc_heading|default('') %}
{% set bc_subhead = content.boxed_copy.bc_subhead|default('') %}
{% set bc_body    = content.boxed_copy.bc_content|default('') %}

{% set bpb = content.boxed_copy_buttons.primary_button|default({}) %}
{% set bsb = content.boxed_copy_buttons.secondary_button|default({}) %}
{% set has_boxed_text = bc_eyebrow or bc_heading or bc_subhead or (bc_body|striptags|trim) %}
{% set has_boxed_btns = bpb.text|default('')|trim or bsb.text|default('')|trim %}

{# -------- BOXED MEDIA (exact control wiring) -------- #}
{% set boxed_media_choice = content.boxed_copy_media.image_or_video|default('')|lower %}

{# Image group under Boxed Copy Media → Image #}
{% set boxed_img = content.boxed_copy_media.image|default({}) %}
{% set img_from  = boxed_img.from|default('media_library')|lower %}
{% set img_media = boxed_img.media|default(null) %}
{% set img_url   = boxed_img.url|default('') %}
{% set img_alt_mode   = boxed_img.alt|default('default')|lower %}
{% set img_custom_alt = boxed_img.customAlt|default('') %}
{% set b_alt = img_alt_mode in ['custom','custom_alt'] ? img_custom_alt : '' %}
{% set b_lazy = boxed_img.lazyLoad is defined ? boxed_img.lazyLoad : true %}

{% set has_boxed_img =
     ((img_from in ['media_library','media']) and img_media)
  or ((img_from == 'url') and (img_url|trim != ''))
%}

{# Video group (keeps compatibility if your video lives in boxed_copy_media.video or content.video) #}
{% set boxed_video = content.boxed_copy_media.video|default(content.video)|default({}) %}
{% set has_boxed_video = boxed_video is defined and boxed_video.video is defined and boxed_video.video %}

{% set show_boxed_img   = (boxed_media_choice in ['image','']) and has_boxed_img %}
{% set show_boxed_video = (boxed_media_choice == 'video') and has_boxed_video %}

{# -------- MAIN MEDIA (separate group) -------- #}
{% set main_choice = content.media.image_or_video|default('')|lower %}
{% set main_img    = content.media.image|default(null) %}
{% set has_main_img = (main_choice == 'image') and main_img and (
  (main_img.media is defined and main_img.media) or
  (main_img.url|default('') != '')
) %}
{% set main_video = content.media.video|default({}) %}
{% set has_main_video = (main_choice == 'video') and (main_video.video is defined and main_video.video) %}
{% set has_main_media = has_main_img or has_main_video %}

{# -------- Default demo content (builder-only if truly empty) -------- #}
{% set has_any_user_content =
  has_main_text or has_main_btns or
  has_boxed_text or has_boxed_btns or
  show_boxed_img or show_boxed_video or
  has_main_media
%}
{% set use_defaults = in_builder and (not has_any_user_content) %}

{% if use_defaults %}
  {# Main copy defaults #}
  {% set eyebrow = 'Lorem ipsum dolor' %}
  {% set heading = 'Lorem ipsum dolor sit amet' %}
  {% set subhead = 'Short supporting subhead' %}
  {% set body    = '<p>This is example body copy so the layout is clear before you add real content.</p>' %}
  {% set has_main_btns = true %}
  {% set demo_primary_text  = 'Contact sales' %}
  {% set demo_secondary_text = 'Learn more ↗' %}

  {# Boxed copy defaults #}
  {% set bc_eyebrow = 'Lorem ipsum dolor' %}
  {% set bc_heading = 'Boxed heading' %}
  {% set bc_subhead = '' %}
  {% set bc_body    = '<p>Boxed body example to show typography and spacing.</p><ul><li>List item</li><li>List item</li><li>List item</li></ul>' %}
  {% set has_boxed_text = true %}
  {% set has_boxed_btns = true %}

  {# Defaults: show ONLY a boxed image, not a main image, to avoid a stray big image below #}
  {% set boxed_media_choice = 'image' %}
  {% set img_from  = 'url' %}
  {% set img_url   = '/wp-content/uploads/2025/06/Placeholder-1-1.png' %}
  {% set b_alt     = '' %}
  {% set b_lazy    = true %}
  {% set show_boxed_img = true %}
  {% set show_boxed_video = false %}

  {# No default main media #}
  {% set has_main_media = false %}
  {% set has_main_img = false %}
  {% set has_main_video = false %}
{% endif %}

<div class="module-container" data-view="content+boxedcopy-final" {{ use_defaults ? 'data-demo="1"' : '' }}>
  <div class="main-copy">
    {% if eyebrow %}<div class="eyebrow">{{ eyebrow }}</div>{% endif %}
    {% if heading %}<h2>{{ heading }}</h2>{% endif %}
    {% if subhead %}<h4>{{ subhead }}</h4>{% endif %}
    {% if body|striptags|trim %}{{ body|raw }}{% endif %}

    {% if has_main_btns or use_defaults %}
      <div class="content-module module-buttons">
        {% if pb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(pb, 'opkey-primary', path.to.button_design_preset_section, 'primary', pb.text|trim) }}
        {% elseif use_defaults %}
          <a href="#" class="button-atom button-atom--primary opkey-primary"><span class="button-atom__text">{{ demo_primary_text }}</span></a>
        {% endif %}
        {% if sb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(sb, 'opkey-link-text', path.to.button_design_preset_section, 'secondary', sb.text|trim) }}
        {% elseif use_defaults %}
          <a href="#" class="button-atom opkey-link-text"><span class="button-atom__text">{{ demo_secondary_text }}</span></a>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {# ================= BOXED CONTENT ================= #}
  {% if has_boxed_text or has_boxed_btns or show_boxed_img or show_boxed_video %}
    <div class="content-module boxed-content">
      <div class="boxed-copy">
        {% if bc_eyebrow %}<div class="boxed-eyebrow">{{ bc_eyebrow }}</div>{% endif %}
        {% if bc_heading %}<h3 class="boxed-heading">{{ bc_heading }}</h3>{% endif %}
        {% if bc_subhead %}<h4 class="boxed-subhead">{{ bc_subhead }}</h4>{% endif %}
        {% if bc_body|striptags|trim %}<div class="boxed-body">{{ bc_body|raw }}</div>{% endif %}

        {% if has_boxed_btns or use_defaults %}
          <div class="content-module module-buttons boxed-buttons">
            {% if bpb.text|default('')|trim %}
              {{ macros.atomV1ButtonHtml(bpb, 'opkey-primary', path.to.button_design_preset_section, 'primary', bpb.text|trim) }}
            {% elseif use_defaults %}
              <a href="#" class="button-atom button-atom--primary opkey-primary"><span class="button-atom__text">{{ demo_primary_text }}</span></a>
            {% endif %}
            {% if bsb.text|default('')|trim %}
              {{ macros.atomV1ButtonHtml(bsb, 'opkey-link-text', path.to.button_design_preset_section, 'secondary', bsb.text|trim) }}
            {% elseif use_defaults %}
              <a href="#" class="button-atom opkey-link-text"><span class="button-atom__text">{{ demo_secondary_text }}</span></a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {# --- BOXED MEDIA RENDER --- #}
      {% if show_boxed_img %}
        <div class="content-module module-media boxed-media" data-choice="image">
          {% if (img_from in ['media_library','media']) and img_media %}
            {{ macros.image(img_media, 'full', b_alt, b_lazy) }}
          {% elseif (img_from == 'url') and (img_url|trim != '') %}
            <img src="{{ img_url|trim }}" alt="{{ b_alt }}" loading="{{ b_lazy ? 'lazy' : 'eager' }}">
          {% endif %}
        </div>

      {% elseif show_boxed_video %}
        <div class="content-module module-media boxed-media" data-choice="video">
          {% set v = boxed_video.video %}
          {% if v.provider == 'youtube' %}
            {% set videoUrl = v.embedUrl %}
            {% if content.youtube.privacy_mode %}
              {% set videoUrl = videoUrl|replace({'https://www.youtube.com/': 'https://www.youtube-nocookie.com/'}) %}
            {% endif %}

            {% set params = '' %}
            {% if content.youtube.autoplay %}{% set params = params ~ '&autoplay=1' %}{% endif %}
            {% if content.youtube.mute %}{% set params = params ~ '&mute=1' %}{% endif %}
            {% if content.youtube.loop and v.videoId %}{% set params = params ~ '&loop=1&playlist=' ~ v.videoId %}{% endif %}
            {% if content.youtube.hide_player_controls %}{% set params = params ~ '&controls=0' %}{% endif %}
            {% if content.youtube.modest_branding %}{% set params = params ~ '&modestbranding=1' %}{% endif %}
            {% if not content.youtube.play_inline %}{% set params = params ~ '&playsinline=0' %}{% endif %}
            {% if content.youtube.start_time %}{% set params = params ~ '&start=' ~ content.youtube.start_time.number %}{% endif %}
            {% if content.youtube.end_time %}{% set params = params ~ '&end=' ~ content.youtube.end_time.number %}{% endif %}
            {% if content.youtube.suggested_videos != 'recommendations' %}{% set params = params ~ '&rel=0' %}{% endif %}

            <iframe
              class="ee-video"
              title="{{ v.title }}"
              src="{{ videoUrl }}{{ params }}"
              width="100%" height="100%" frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen>
            </iframe>
          {% else %}
            {{ macros.video(v) }}
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  {# ================= MAIN MEDIA ================= #}
  {% if has_main_img %}
    {% set m_alt  = (main_img.alt is defined and main_img.alt.customAlt is defined) ? main_img.alt.customAlt : '' %}
    {% set m_lazy = main_img.lazyLoad is defined ? main_img.lazyLoad : true %}
    <div class="content-module module-media">
      {% if main_img.media|default(0) %}
        {{ macros.image(main_img.media, content.media.size|default(content.content.size|default('full')), m_alt, m_lazy) }}
      {% else %}
        <img src="{{ main_img.url }}" alt="{{ m_alt }}" loading="{{ m_lazy ? 'lazy' : 'eager' }}" />
      {% endif %}
    </div>
  {% elseif has_main_video %}
    <div class="ee-video-container">
      {{ macros.video(main_video.video) }}
    </div>
  {% endif %}
</div>
