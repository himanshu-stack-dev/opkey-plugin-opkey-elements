<div class="module-container">
  <div class="main-copy">
    {# EYEBROW #}
    {% set eyebrow = content.eyebrow.text %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}

    {# HEADING #}
    {% set heading = content.heading.text  %}
    {% if heading %}
      <h2>{{ heading }}</h2>
    {% endif %}

    {# SUBHEAD #}
    {% set subhead = content.subhead.text  %}
    {% if subhead %}
      <h4>{{ subhead }}</h4>
    {% endif %}

    {# BODY #}
    {% set body = content.content.text  %}
    {% if body %}
      <p>{{ body }}</p>
    {% endif %}

    {# BUTTONS #}
    {% set pb = content.buttons.primary_button|default({}) %}
    {% set sb = content.buttons.secondary_button|default({}) %}

    {% if pb.text|default('')|trim or sb.text|default('')|trim %}
      <div class="content-module module-buttons">
        {% if pb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               pb,
               'opkey-primary',
               path.to.button_design_preset_section,
               'primary',
               pb.text|trim
             ) }}
        {% endif %}
        {% if sb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               sb,
               'opkey-link-text',
               path.to.button_design_preset_section,
               'secondary',
               sb.text|trim
             ) }}
        {% endif %}
      </div>
    {% endif %}
  </div>

  {# BOXED CONTENT #}
  <div class="content-module boxed-content">
    <div class="boxed-copy">
      {# EYEBROW #}
      {% if content.boxed_copy.eyebrow.text %}
        <div class="eyebrow">{{ content.boxed_copy.eyebrow.text }}</div>
      {% endif %}

      {# HEADING #}
      {% if content.boxed_copy.heading.text %}
        <h3>{{ content.boxed_copy.heading.text }}</h3>
      {% endif %}

      {# SUBHEAD #}
      {% if content.boxed_copy.subhead.text %}
        <h4>{{ content.boxed_copy.subhead.text }}</h4>
      {% endif %}

      {# BODY #}
      {% if content.boxed_copy.content.text %}
        <p>{{ content.boxed_copy.content.text }}</p>
      {% endif %}

      {# BOXED COPY BUTTONS #}
      {% set bpb = content.boxed_copy_buttons.primary_button|default({}) %}
      {% set bsb = content.boxed_copy_buttons.secondary_button|default({}) %}

      {% if bpb.text|default('')|trim or bsb.text|default('')|trim %}
        <div class="content-module module-buttons">
          {% if bpb.text|default('')|trim %}
            {{ macros.atomV1ButtonHtml(
                 bpb,
                 'opkey-primary',
                 path.to.button_design_preset_section,
                 'primary',
                 bpb.text|trim
               ) }}
          {% endif %}
          {% if bsb.text|default('')|trim %}
            {{ macros.atomV1ButtonHtml(
                 bsb,
                 'opkey-link-text',
                 path.to.button_design_preset_section,
                 'secondary',
                 bsb.text|trim
               ) }}
          {% endif %}
        </div>
      {% endif %}
    </div>
    {# MEDIA #}
    {% set media_type = content.media.image_or_video  %}
    {% if media_type == 'image' %}
      <div class="content-module module-media">
      {% if content.image.media %}
          {{ macros.image(content.image.media, content.content.size, alt, lazyLoad) }}
        {% else %}
          <img src="/wp-content/uploads/2025/06/Placeholder-620x500-1.png" alt="Placeholder image" class="breakdance-image-object" style="width:100%; height:auto;" />
        {% endif %}
      </div>
    {% elseif media_type == 'video' %}
      <div class="ee-video-container">
        {% if content.video.video.provider == 'vimeo' %}
          {% set isLazyLoad = content.vimeo.loading_method != 'embed' and not isBuilder %}
          {% set srcAttribute = isLazyLoad ? 'data-src' : 'src' %}
          <div class="ee-video ee-vimeo">
            <iframe
              class="ee-video {{ isLazyLoad ? 'lozad' : '' }}"
              title="{{ content.video.video.title }}"
              {{ srcAttribute }}="{{ content.video.video.embedUrl }}{{ content.vimeo.autoplay ? '&autoplay=1' }}{{ content.vimeo.hide_player_controls ? '&controls=0' : '&controls=1' }}{{ content.vimeo.loop ? '&loop=1' : '' }}{{ content.vimeo.mute ? '&muted=1' : '' }}{{ not content.vimeo.play_inline ? '&playsinline=0' : '' }}{{ content.vimeo.start_time ? '#t=' ~ content.vimeo.start_time.number : '' }}"
              width="100%" height="100%" frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture" allowfullscreen>
            </iframe>
          </div>
        {% endif %}
        {% if content.video.video.provider == 'youtube' %}
          {% set isLazyLoad = content.youtube.loading_method != 'embed' and not isBuilder %}
          {% set srcAttribute = isLazyLoad ? 'data-src' : 'src' %}
          <div class="ee-video ee-youtube">
            <iframe
              class="ee-video {{ isLazyLoad ? 'lozad' : '' }}"
              title="{{ content.video.video.title }}"
              {{ srcAttribute }}="{{ content.video.video.embedUrl }}{{ content.youtube.autoplay ? '&autoplay=1' }}{{ content.youtube.hide_player_controls ? '&controls=0' : '&controls=1' }}{{ content.youtube.loop ? '&loop=1' : '' }}{{ content.youtube.mute ? '&muted=1' : '' }}{{ not content.youtube.play_inline ? '&playsinline=0' : '' }}{{ content.youtube.start_time ? '&start=' ~ content.youtube.start_time.number : '' }}"
              width="100%" height="100%" frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture" allowfullscreen>
            </iframe>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>