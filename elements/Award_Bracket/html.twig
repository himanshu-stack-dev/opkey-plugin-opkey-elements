<div class="module-container">
  {% set ey   = content.eyebrow.text               |default('')|trim %}
  {% set hd   = content.heading.text               |default('')|trim %}
  {% set sh   = content.subhead.text               |default('')|trim %}
  {% set bd   = content.content.text               |default('')|trim %}
  {% set pbt  = content.buttons.primary_button.text   |default('')|trim %}
  {% set sbt  = content.buttons.secondary_button.text |default('')|trim %}

  {% if ey or hd or sh or bd or pbt or sbt %}
    <div class="module-columns module-text">
      {% if ey %}<div class="eyebrow">{{ ey }}</div>{% endif %}
      {% if hd %}<h2>{{ hd }}</h2>{% endif %}
      {% if sh %}<h4>{{ sh }}</h4>{% endif %}
      {% if bd %}<p>{{ bd }}</p>{% endif %}

      {% if pbt or sbt %}
        <div class="content-module module-buttons">
          {% if pbt %}
            {{ macros.atomV1ButtonHtml(
                 content.buttons.primary_button,
                 'opkey-primary',
                 path.to.button_design_preset_section,
                 'primary',
                 pbt
            ) }}
          {% endif %}
          {% if sbt %}
            {{ macros.atomV1ButtonHtml(
                 content.buttons.secondary_button,
                 'opkey-link-text',
                 path.to.button_design_preset_section,
                 'secondary',
                 sbt
            ) }}
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  {% set default_awards = [
    '/wp-content/uploads/2025/07/award-high-performer.png',
    '/wp-content/uploads/2025/07/award-capterra.png',
    '/wp-content/uploads/2025/07/award-gartner.png'
  ] %}
  {% set awards = (content.awards.item is defined and content.awards.item|length > 0)
      ? content.awards.item
      : default_awards
  %}

  {% set default_partners = [
    '/wp-content/uploads/2025/07/Placeholder_180x70.png',
    '/wp-content/uploads/2025/07/Placeholder_180x70.png',
    '/wp-content/uploads/2025/07/Placeholder_180x70.png',
    '/wp-content/uploads/2025/07/Placeholder_180x70.png'
  ] %}
  {% set partners = (content.partners.logos is defined and content.partners.logos|length > 0)
      ? content.partners.logos
      : default_partners
  %}

  <div class="columns">
    <div class="column">
      <div class="column-container">
        <svg preserveAspectRatio="none" viewBox="0 0 5 452" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 1V1C2.79086 1 1 2.79087 1 5V447C1 449.209 2.79086 451 5 451V451" stroke="currentColor"/>
        </svg>
        <div class="column-text">
          <h4>Our Awards</h4>
          <div class="awards">
            {% for item in awards %}
              {% if item.graphic is defined %}
                {{ macros.image(item.graphic, content.content.size, alt, lazyLoad) }}
              {% else %}
                <img src="{{ item }}" alt="Award" loading="lazy" />
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <svg class="right" preserveAspectRatio="none" viewBox="0 0 5 452" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 1V1C2.79086 1 1 2.79087 1 5V447C1 449.209 2.79086 451 5 451V451" stroke="currentColor"/>
        </svg>
      </div>
    </div>

    <div class="column">
      <div class="column-container">
        <svg preserveAspectRatio="none" viewBox="0 0 5 452" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 1V1C2.79086 1 1 2.79087 1 5V447C1 449.209 2.79086 451 5 451V451" stroke="currentColor"/>
        </svg>
        <div class="column-text">
          <h4>Our Partners</h4>
          <div class="partners">
            {% for item in partners %}
              {% if item.image is defined %}
                {{ macros.image(item.image, content.content.size, alt, lazyLoad) }}
              {% else %}
                <img src="{{ item }}" alt="Partner" loading="lazy" />
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <svg class="right" preserveAspectRatio="none" viewBox="0 0 5 452" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 1V1C2.79086 1 1 2.79087 1 5V447C1 449.209 2.79086 451 5 451V451" stroke="currentColor"/>
        </svg>
      </div>
    </div>
  </div>
</div>
