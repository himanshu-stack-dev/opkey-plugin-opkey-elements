{% set defaults = {
  eyebrow: 'INTEGRATIONS',
  heading: 'Opkey’s pre-built integrations',
  subhead: 'With dozens of pre-built connectors and integrations, Opkey works seamlessly within your environment.',
  categories: [
    {
      title: 'Category 1',
      resources: [
        {
          icon: { url: '/wp-content/uploads/2025/06/icon-robot.svg' },
          heading: 'RESOURCE TYPE',
          content: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
          button: { text: 'Learn more', url: '#' }
        },
        {
          icon: { url: '/wp-content/uploads/2025/06/icon-robot.svg' },
          heading: 'RESOURCE TYPE',
          content: 'Another awesome resource in category 1.',
          button: { text: 'Learn more', url: '#' }
        }
      ]
    },
    {
      title: 'Category 2',
      resources: [
        {
          icon: { url: '/wp-content/uploads/2025/06/icon-robot.svg' },
          heading: 'RESOURCE TYPE',
          content: 'Category 2 resource content goes here.',
          button: { text: 'Learn more', url: '#' }
        }
      ]
    }
  ]
} %}
<div class="module-container">
  <div class="module-top-nav-accordion module-text">
    {% set eyebrow = content.eyebrow.text %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}

    {% set heading = content.heading.text %}
    {% if heading %}
      <h2>{{ heading }}</h2>
    {% endif %}

    {% set subhead = content.subhead.text %}
    {% if subhead %}
      <h4>{{ subhead }}</h4>
    {% endif %}

    {% set body = content.content.text %}
    {% if body %}
      <p>{{ body }}</p>
    {% endif %}
  </div>

{# Render user content if any resource is "real", else render defaults #}
{% set show_defaults = true %}
{% if content.categories.category is defined and content.categories.category|length > 0 %}
  {% for cat in content.categories.category %}
    {% if cat.resources is defined and cat.resources|length > 0 %}
      {% for res in cat.resources %}
        {% if res.icon.url is defined or res.heading|length > 0 or res.content|length > 0 %}
          {% set show_defaults = false %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Assign categories variable based on the flag #}
{% set categories = show_defaults ? defaults.categories : content.categories.category %}

  <div class="module-content-row">
    <div class="tab-nav bde-tab-list desktop-only">
      {% for category in categories %}
        <button
          class="bde-tab {{ content.categories.simple_list_ ? ' simple-list' : '' }}"
          id="tab-{{ loop.index }}"
          type="button"
          role="tab"
          aria-controls="tabpanel-{{ loop.index }}"
          aria-selected="{{ loop.first ? 'true' : 'false' }}"
          data-category-index="{{ loop.index }}"
        >
          {{ category.title }}
        </button>
      {% endfor %}

      {% if not content.categories.simple_list_ %}
        <div class="slider-navigation desktop-only slider-navigation-%%UNIQUESLUG%%">
          <button class="swiper-button-prev swiper-button-prev-%%UNIQUESLUG%% custom-nav-btn"></button>
          <div class="swiper-pagination swiper-pagination-%%UNIQUESLUG%%"></div>
          <button class="swiper-button-next swiper-button-next-%%UNIQUESLUG%% custom-nav-btn"></button>
        </div>
      {% endif %}
    </div>

    <div class="tab-dropdown mobile-only">
      <select id="category-select-%%UNIQUESLUG%%">
        {% for category in categories %}
          <option value="{{ loop.index }}" {{ loop.first ? 'selected' : '' }}>{{ category.title }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="breakdance-swiper-wrapper" data-swiper-id="%%UNIQUESLUG%%">
      <div class="swiper swiper-%%UNIQUESLUG%%">
        <div class="swiper-wrapper">
          {# Leave empty — JS will populate #}
        </div>
      </div>

        <div class="slider-navigation mobile-only">
          <button class="swiper-button-prev swiper-button-prev-%%UNIQUESLUG%% custom-nav-btn"></button>
          <div class="swiper-pagination swiper-pagination-%%UNIQUESLUG%%"></div>
          <button class="swiper-button-next swiper-button-next-%%UNIQUESLUG%% custom-nav-btn"></button>
        </div>
    </div>

    {# Hidden slide storage goes outside Swiper! #}
    <div class="all-slide-groups" style="display: none;">
      {% for category in categories %}
        {% for resource in category.resources %}
          <div class="swiper-slide" data-category-index="{{ loop.parent.loop.index }}">
            <div class="card">
              <svg preserveAspectRatio="none" viewBox="0 0 5 452" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 1V1C2.79086 1 1 2.79087 1 5V447C1 449.209 2.79086 451 5 451V451" stroke="currentColor"/>
              </svg>

              <div class="icon">
                {% if resource.icon.url is defined %}
                  <img src="{{ resource.icon.url }}" alt="" class="breakdance-image-object" style="width:60px; height:auto; margin-bottom: 1rem;" />
                {% endif %}
              </div>

              <div class="mobile-eyebrow">
                <span class="resource-type" style="color: #12a4b4; letter-spacing: 0.03em; font-weight: 600; font-size: 1rem; text-transform: uppercase;">
                  {{ resource.heading ?? 'Resource Type' }}
                </span>
              </div>

              <div class="richtext-content">
                {{ resource.content }}
              </div>

              {% set btn = resource.button ?? {} %}
              {% if btn.html is defined or (btn.text is defined and btn.text|length > 0) %}
                <div class="content-module module-buttons">
                  {{ btn.html is defined 
                    ? btn.html 
                    : macros.atomV1ButtonHtml(btn, 'opkey-link-text', path.to.button_design_preset_section, 'secondary', btn.text) 
                  }}
                </div>
              {% endif %}

              <svg class="right" preserveAspectRatio="none" viewBox="0 0 5 452" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 1V1C2.79086 1 1 2.79087 1 5V447C1 449.209 2.79086 451 5 451V451" stroke="currentColor"/>
              </svg>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>