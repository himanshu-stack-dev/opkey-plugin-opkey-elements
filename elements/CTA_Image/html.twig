<div class="module-container">
  <div class="gradient-wrapper">
    <div class="module-text">
      {# EYEBROW #}
      {% set eyebrow = content.eyebrow.text %}
      {% if eyebrow %}
        <div class="eyebrow">{{ eyebrow }}</div>
      {% endif %}
      {# HEADING #}
      {% set heading = content.heading.text  %}
      {% if heading %}
        <h2>{{ heading }}</h2>
      {% endif %}
      {# BODY #}
      {% set body = content.content.text  %}
      {% if body %}
        {{ body }}
      {% endif %}

      {# BUTTONS #}
      {% set pb = content.button.primary_button|default({}) %}

      {% if pb.text|default('')|trim %}
        <div class="content-module module-buttons">
          {{ macros.atomV1ButtonHtml(
               pb,
               'opkey-link-text',
               path.to.button_design_preset_section,
               'secondary',
               sb.text|trim
             ) }}
        </div>
      {% endif %}
    </div>
    {# IMAGE with robust fallback #}
    {% set image_set = (content.image.image is defined and content.image.image.url is not empty) %}
    {% set alt = (image_set and content.image.image.alt is defined) ? content.image.image.alt : 'Placeholder image' %}
    <div class="module-image">
      {% if image_set %}
        {{ macros.image(content.image.image, content.content.size, alt, lazyLoad) }}
      {% else %}
        <img src="/wp-content/uploads/2025/07/Placeholder_510x300.png"
             alt="Placeholder image"
             width="510"
             height="300"
             loading="lazy" />
      {% endif %}
    </div>
  </div>
</div>
