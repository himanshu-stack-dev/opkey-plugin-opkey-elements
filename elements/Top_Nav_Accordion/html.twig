<div class="module-container">
  <div class="module-top-nav-accordion module-text">
    {# EYEBROW #}
    {% set eyebrow = content.eyebrow.text %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}

    {# HEADING #}
    {% set heading = content.heading.text  %}
    {% if heading %}
      <h2>{{ heading }}</h2>
    {% endif %}

    {# SUBHEAD #}
    {% set subhead = content.subhead.text  %}
    {% if subhead %}
      <h4>{{ subhead }}</h4>
    {% endif %}

    {# BODY #}
    {% set body = content.content.text  %}
    {% if body %}
      <p>{{ body }}</p>
    {% endif %}
  </div>

  {% set has_tabs = content.navigator.tabs is defined and content.navigator.tabs|length > 0 %}
  {% set tabs = has_tabs 
    ? content.navigator.tabs 
    : [
        {
          tab_title: 'Lorem ipsum dolor',
          accordion: [
            {
              content_icon: '/wp-content/uploads/2025/07/Icon_Automate-1.svg',
              content_image: '/wp-content/uploads/2025/06/Placeholder-620x500-1.png',
              content_title: 'First accordion item',
              content: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.'
            },
            {
              content_icon: '/wp-content/uploads/2025/07/Icon_Automate-1.svg',
              content_image: '/wp-content/uploads/2025/06/Placeholder-620x500-1.png',
              content_title: 'Second accordion item',
              content: 'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.'
            }
          ],
        },
        {
          tab_title: 'Dolor sit amet',
          accordion: [
            {
              content_icon: '/wp-content/uploads/2025/07/Icon_Automate-1.svg',
              content_image: '/wp-content/uploads/2025/06/Placeholder-620x500-1.png',
              content_title: 'Third accordion item',
              content: 'Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Duis aute irure dolor in reprehenderit.'
            },
            {
              content_icon: '/wp-content/uploads/2025/07/Icon_Automate-1.svg',
              content_image: '/wp-content/uploads/2025/06/Placeholder-620x500-1.png',
              content_title: 'Fourth accordion item',
              content: 'Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.'
            }
          ],
        }
      ]
  %}

  <div class="module-navigator bde-accordion-nav-with-media">
    <div class="breakdance-swiper-wrapper show-mobile" data-swiper-id="%%UNIQUESLUG%%">

      {# DROPDOWN SELECTOR FOR PERSONAS (Tabs) #}
      {# Default to the first tab being selected initially #}
      {% set active_index = 0 %}
      {% set active_tab = tabs[active_index] %}

      <div class="bde-mobile-dropdown-wrapper">
        <button class="bde-accordion-trigger bde-mobile-tab-trigger" aria-expanded="false" tabindex="0">
          <span class="bde-accordion-title">{{ active_tab.tab_title }}</span>
        </button>

        <ul class="bde-mobile-dropdown-options" style="display: none;">
          {% for tab in tabs %}
            {% if loop.index0 != active_index %}
              <li data-tab-index="{{ loop.index0 }}">{{ tab.tab_title }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      {# CONTENT FOR EACH PERSONA (One Swiper per tab) #}
      {% for tab in tabs %}
        <div class="bde-mobile-tab-content tab-{{ loop.index0 }}" data-tab-title="{{ tab.tab_title }}" {% if not loop.first %}style="display:none;"{% endif %}>
          <div class="swiper swiper-{{ loop.index0 }}">
            <div class="swiper-wrapper">
              {% for item in tab.accordion %}
                <div class="swiper-slide">
                  <div class="bde-accordion-item has-icon open">
                    <div class="bde-accordion-row">
                      <div class="bde-mobile-accordion-item">
                        {% if item.content_icon %}
                          <span class="bde-accordion-icon">
                            <img src="{{ item.content_icon is iterable ? item.content_icon.url : item.content_icon }}" alt="Icon" style="width:36px;height:36px;" />
                          </span>
                        {% endif %}
                        <h3>{{ item.content_title }}</h3>
                      </div>
                      <div class="bde-accordion-content breakdance-rich-text-styles">
                        {{ item.content }}
                      </div>
                    </div>

                    {% if item.content_image %}
                      <div class="bde-accordion-media">
    <img src="{{ item.content_image is iterable ? item.content_image.url : item.content_image }}" alt="Accordion image" style="max-width:100%; height:auto;" />
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
            <div class="slider-navigation">
              <button class="swiper-button-prev swiper-button-prev-{{ loop.index0 }} custom-nav-btn"></button>
              <div class="swiper-pagination swiper-pagination-{{ loop.index0 }}"></div>
              <button class="swiper-button-next swiper-button-next-{{ loop.index0 }} custom-nav-btn"></button>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="bde-accordion-tabs show-desktop">
      <div class="bde-tab-list" role="tablist">
        {% for tab in tabs %}
          <button
            class="bde-tab"
            id="tab-{{ loop.index }}"
            type="button"
            role="tab"
            aria-controls="tabpanel-{{ loop.index }}"
            aria-selected="{{ loop.first ? 'true' : 'false' }}"
          >
            {{ tab.tab_title }}
          </button>
        {% endfor %}
      </div>

      <div class="bde-tabpanels">
        {% for tab in tabs %}
        <div class="bde-tabpanel" id="tabpanel-{{ loop.index }}" role="tabpanel" aria-labelledby="tab-{{ loop.index }}" {% if not loop.first %}style="display:none;"{% endif %}>
        
          {% set accordion_items = (tab.accordion is defined and tab.accordion|length > 0) 
            ? tab.accordion 
            : [{
                content_icon: '/wp-content/uploads/2025/07/Icon_Automate-1.svg',
                content_image: '/wp-content/uploads/2025/06/Placeholder-620x500-1.png',
                content_title: 'Lorem ipsum dolor sit amet consectetur sed do eiusmod',
                content: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.'
              }] %}

          <div class="bde-accordion-column"> {# LEFT column: accordion list #}
            <div class="bde-accordion-list">
              {% for item in accordion_items %}
                {% set has_icon = (item.content_icon is iterable and item.content_icon.url is defined)
                  or (item.content_icon is defined and item.content_icon is not empty) %}
                <div class="bde-accordion-item{{ has_icon ? ' has-icon' : '' }}">
                  <div class="bde-accordion-content">
                    <button class="bde-accordion-trigger" aria-expanded="false">
                      {% if has_icon %}
                        <span class="bde-accordion-icon">
                          <img src="{{ item.content_icon is iterable ? item.content_icon.url : item.content_icon }}" alt="Icon" style="width:36px;height:36px;" />
                        </span>
                      {% endif %}
                      <span class="bde-accordion-title">{{ item.content_title }}</span>
                    </button>
                    <div class="bde-accordion-panel">
                      <div class="bde-accordion-text breakdance-rich-text-styles">
                        {{ item.content }}
                      </div>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>

          <div class="bde-accordion-media"> {# RIGHT column: images #}
            {% for item in accordion_items %}
              {% set has_image = (item.content_image is iterable and item.content_image.url is defined)
                or (item.content_image is defined and item.content_image is not empty) %}
              {% if has_image %}
                <div class="bde-accordion-image" style="display:none;">
                  <img src="{{ item.content_image is iterable ? item.content_image.url : item.content_image }}" alt="Accordion image" style="max-width:100%; height:auto;" />
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>