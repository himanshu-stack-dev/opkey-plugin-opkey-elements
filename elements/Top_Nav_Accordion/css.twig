{% if design.container.overlay %}
  %%SELECTOR%% .ee-video-overlay {
  position:absolute;
  top:0;
  left:0;
  bottom:0;
  right:0;
  background-color: {{ design.container.overlay }};
  pointer-events:none;
}
{% endif %}
%%SELECTOR%% .ee-video-container {
  {% if content.video.ratio == 'custom' %}
    {% set ratiow = content.video.custom_width %}
    {% set ratioh = content.video.custom_height %}

    {# if ratiow is not set, we can end up dividing by 0 and blowing up #}
    {% if ratiow and ratioh %}
      {% set customratio = ratioh / ratiow * 100 %}
      padding-top: {{ customratio }}%;
    {% endif %}
  {% elseif content.video.ratio %}
    padding-top: {{ content.video.ratio }};
  {% endif %}
}

{% if content.lazy_load.lazy_load %}
  /* lazy-load */
  %%SELECTOR%% .ee-video img {
    width:100%;
    height:100%;
    object-fit:cover;
  }

  %%SELECTOR%% .ee-video-container iframe {
    object-fit:cover;
    display:flex;
    justify-content:center;
    align-items:center;
    cursor: pointer;
  }

  /* button */
  %%SELECTOR%% .ee-video .ee-play-button {
  display: flex;
  color: {{ design.lazy_load.icon_color  }};
  font-size: {{ design.lazy_load.icon_size.style  }};
  position: absolute;
  left: 50%;
  top: 50%;
  width: 68px;
  height: 48px;
  margin-left: -34px;
  margin-top: -24px;
  transition:0.3s ease color;
  }
  %%SELECTOR%% .ee-video .ee-play-button:hover {
  color: {{ design.lazy_load.icon_color_hover }};
  }

  %%SELECTOR%% .ee-play-button > svg {
  font-size: inherit;
  width: 1em;
  height: 1em;
  stroke-width: 0;
  stroke: currentColor;
  fill: currentColor;
  }
{% endif %}

/* PADDING */
{% if design.remove_padding.remove_top %}
      %%SELECTOR%% { padding-top:0!important }
{% elseif design.remove_padding.remove_bottom  %}
      %%SELECTOR%% { padding-bottom:0!important }
{% endif %}


{% if design.theme_color.color == 'purple' %}
    %%SELECTOR%% { background: #190D2C; color: #fff; }
    %%SELECTOR%% h1, %%SELECTOR%% h3, %%SELECTOR%% h4 { color: #fff; }
	%%SELECTOR%% p, %%SELECTOR%% ul, %%SELECTOR%% ol, %%SELECTOR%% .bde-accordion-content { color: #CEDDDF; }
	%%SELECTOR%% .bde-accordion-icon { filter:invert(100%); }
	/* SLIDER */
	%%SELECTOR%% .custom-nav-btn::after { border-top:2px solid #000; border-right:2px solid #000; }
	%%SELECTOR%% .custom-nav-btn { background:white; }
	%%SELECTOR%% .slider-navigation .swiper-pagination-bullet-active { background:white; }
	%%SELECTOR%% .slider-navigation .swiper-pagination-bullet
    /* MOBILE: Primary button text color black */
    @media (max-width: 1023px) {
      %%SELECTOR%% .opkey-link-text .button-atom__text { color: #fff !important; }
    }
	@media (min-width: 1024px) {
      %%SELECTOR%% .bde-tab-list button[aria-selected="true"],
      %%SELECTOR%%.bde-tab-list button[aria-selected="true"]:hover { color:black; background:white; }
      %%SELECTOR%% .bde-tab-list button,
      %%SELECTOR%% .bde-accordion-title { color:white; }
      %%SELECTOR%% .bde-tab-list button::before, 
      %%SELECTOR%% .bde-tab-list button::after { filter:invert(100%); }
	}
{% elseif design.theme_color.color == 'light-gray' %}
    %%SELECTOR%% { background: #EDF7F9; }
{% endif %}
