{% set columns = content.columns.column | length > 0 ? content.columns.column : default_columns %}
<div class="module-container {% if columns|length > 2 %}stacked{% else %}sidebyside{% endif %}">
  <div class="module-text">
    {# EYEBROW #}
    {% set eyebrow = content.eyebrow.text %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}

    {# HEADING #}
    {% set heading = content.heading.text  %}
    {% if heading %}
      <h2>{{ heading }}</h2>
    {% endif %}

    {# SUBHEAD #}
    {% set subhead = content.subhead.text  %}
    {% if subhead %}
      <h4>{{ subhead }}</h4>
    {% endif %}

    {# BODY #}
    {% set body = content.content.text  %}
    {% if body %}
      <p>{{ body }}</p>
    {% endif %}

    {# BUTTONS #}
    {% set pb = content.buttons.primary_button|default({}) %}
    {% set sb = content.buttons.secondary_button|default({}) %}
    {% if pb.text|default('')|trim or sb.text|default('')|trim %}
      <div class="content-module module-buttons">
        {% if pb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               pb,
               'opkey-primary',
               path.to.button_design_preset_section,
               'primary',
               pb.text|trim
             ) }}
        {% endif %}
        {% if sb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               sb,
               'opkey-link-text',
               path.to.button_design_preset_section,
               'secondary',
               sb.text|trim
             ) }}
        {% endif %}
      </div>
    {% endif %}
  </div>

  {# COLUMNS #}  
  {# Fallback/default columns #}
  {% set default_columns = [
    {
      image: null,
      eyebrow: "Resource Type",
      heading: "Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod",
      content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
      button: { text: "Learn more", url: "#" }
    },
    {
      image: null,
      eyebrow: "Resource Type",
      heading: "Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod",
      content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
      button: { text: "Learn more", url: "#" }
    },
    {
      image: null,
      eyebrow: "Resource Type",
      heading: "Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod",
      content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
      button: { text: "Learn more", url: "#" }
    }
  ] %}

  {# Use columns if they exist, otherwise fallback to two defaults #}

  <div class="columns">
    <div class="breakdance-swiper-wrapper" data-swiper-id="%%ID%%">
      <div class="swiper swiper-%%UNIQUESLUG%%">
        <div class="swiper-wrapper">
          {% for item in columns %}
            <div class="swiper-slide column">
              <div class="column-container">
                <svg preserveAspectRatio="none" viewBox="0 0 5 452" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 1V1C2.79086 1 1 2.79087 1 5V447C1 449.209 2.79086 451 5 451V451" stroke="currentColor"/>
                </svg>
                <div class="column-image">
                  {# robustly extract a URL from item.button (array OR string) #}
                  {% set image_link = '' %}
                  {% if item.button is defined %}
                    {% if item.button is iterable %}
                      {# common Breakdance shapes: button.link.url OR button.url OR button.href #}
                      {% set image_link = (item.button.link.url
                                           |default(item.button.url
                                           |default(item.button.href
                                           |default(''))))|trim %}
                    {% else %}
                      {# plain string URL #}
                      {% set image_link = item.button|trim %}
                    {% endif %}
                  {% endif %}
                  {% set image_link_valid = image_link not in ['', '#', '#!'] %}
                  {% if image_link_valid %}
                    <a href="{{ image_link|e('html_attr') }}"
                       class="column-image-link">
                  {% endif %}

                    {% if item.image %}
                      {{ macros.image(item.image, content.content.size, item.image.alt|default(''), lazyLoad) }}
                    {% else %}
                      <img src="/wp-content/plugins/opkey-elements/assets/Placeholder-376x200.svg"
                           alt="Placeholder image" class="breakdance-image-object" style="width:100%; height:auto;" />
                    {% endif %}

                  {% if image_link_valid %}
                    </a>
                  {% endif %}
                </div>
                <div class="column-text">
                  <span class="mobile-eyebrow">{{ item.eyebrow  }}</span>
                  <h3>{{ item.heading  }}</h3>
                  {{ item.content  }}
                  {% if item.button is defined and item.button.text|default('')|trim != '' %}
                    <div class="content-module module-buttons">
                      {{ macros.atomV1ButtonHtml(
                        item.button,
                        'opkey-link-text',
                        path.to.button_design_preset_section,
                        'secondary',
                        item.button.text|trim
                      ) }}
                    </div>
                  {% endif %}
                </div>
                <svg class="right" preserveAspectRatio="none" viewBox="0 0 5 452" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 1V1C2.79086 1 1 2.79087 1 5V447C1 449.209 2.79086 451 5 451V451" stroke="currentColor"/>
                </svg>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
    <div class="slider-navigation" aria-label="Carousel controls">
      <button
        type="button"
        class="swiper-button-prev swiper-button-prev-%%UNIQUESLUG%% custom-nav-btn"
        aria-label="Previous slide">
      </button>

      <div
        class="swiper-pagination swiper-pagination-%%UNIQUESLUG%%"
        aria-label="Slide pagination"
        aria-live="polite">
      </div>

      <button
        type="button"
        class="swiper-button-next swiper-button-next-%%UNIQUESLUG%% custom-nav-btn"
        aria-label="Next slide">
      </button>
    </div>
</div>