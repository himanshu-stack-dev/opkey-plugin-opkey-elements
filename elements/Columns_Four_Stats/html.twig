<div class="module-container">
  <div class="module-columns module-text">
    {# EYEBROW #}
    {% set eyebrow = content.eyebrow.text %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}

    {# HEADING #}
    {% set heading = content.heading.text  %}
    {% if heading %}
      <h2>{{ heading }}</h2>
    {% endif %}

    {# SUBHEAD #}
    {% set subhead = content.subhead.text  %}
    {% if subhead %}
      <h4>{{ subhead }}</h4>
    {% endif %}

    {# BODY #}
    {% set body = content.content.text  %}
    {% if body %}
      <p>{{ body }}</p>
    {% endif %}

    {# BUTTONS #}
    {% set pb = content.buttons.primary_button|default({}) %}
    {% set sb = content.buttons.secondary_button|default({}) %}

    {% if pb.text|default('')|trim or sb.text|default('')|trim %}
      <div class="content-module module-buttons">
        {% if pb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               pb,
               'opkey-primary',
               path.to.button_design_preset_section,
               'primary',
               pb.text|trim
             ) }}
        {% endif %}
        {% if sb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               sb,
               'opkey-link-text',
               path.to.button_design_preset_section,
               'secondary',
               sb.text|trim
             ) }}
        {% endif %}
      </div>
    {% endif %}
  </div>

  {# COLUMNS #}  
  {# Fallback/default columns #}
  {% set default_columns = [
    {
      heading: "Lorem ipsum dolor sit amet",
      stat: "90%",
      content: "Lorem ipsum dolor sit amet",
      button: { text: "Learn more", url: "#" }
    },
    {
      heading: "Lorem ipsum dolor sit amet",
      stat: "90%",
      content: "Lorem ipsum dolor sit amet",
      button: { text: "Learn more", url: "#" }
    },
    {
      heading: "Lorem ipsum dolor sit amet",
      stat: "90%",
      content: "Lorem ipsum dolor sit amet",
      button: { text: "Learn more", url: "#" }
    },
    {
      heading: "Lorem ipsum dolor sit amet",
      stat: "90%",
      content: "Lorem ipsum dolor sit amet",
      button: { text: "Learn more", url: "#" }
    }
  ] %}

  {# Use columns if they exist, otherwise fallback to two defaults #}
  {% set columns = content.columns.column | length > 0 ? content.columns.column : default_columns %}

  <div class="columns">
    {% for item in columns %}
      <div class="column">
        <div class="column-container">
          <svg preserveAspectRatio="none" viewBox="0 0 5 452" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 1V1C2.79086 1 1 2.79087 1 5V447C1 449.209 2.79086 451 5 451V451" stroke="currentColor"/>
          </svg>
          <div class="column-text">
            {# Heading fallback #}
            <h4>{{ item.heading  }}</h4>

            {# Stat fallback #}
            <div class="module-stat">{{ item.stat  }}</div>

            {# Body fallback #}
            <p>{{ item.content  }}</p>

            {# BUTTON with fallback #}
            {% set button_obj = (item.button is defined and item.button.text|length > 0) 
              ? item.button 
              : { text: 'Learn more', url: '#' } %}
            {% if button_obj.text %}
              <div class="content-module module-buttons">
                {{ macros.atomV1ButtonHtml(
                    button_obj,
                    'opkey-link-text',
                    path.to.button_design_preset_section,
                    'secondary',
                    button_obj.text
                ) }}
              </div>
            {% endif %}
          </div>
          <svg class="right" preserveAspectRatio="none" viewBox="0 0 5 452" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 1V1C2.79086 1 1 2.79087 1 5V447C1 449.209 2.79086 451 5 451V451" stroke="currentColor"/>
          </svg>
        </div>
      </div>
    {% endfor %}
  </div>
</div>