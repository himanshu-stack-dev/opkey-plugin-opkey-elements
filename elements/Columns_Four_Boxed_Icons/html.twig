<div class="module-container">
  <div class="module-columns module-text">
    {# EYEBROW #}
    {% set eyebrow = content.eyebrow.text %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}

    {# HEADING #}
    {% set heading = content.heading.text %}
    {% if heading %}
      <h2>{{ heading }}</h2>
    {% endif %}

    {# SUBHEAD #}
    {% set subhead = content.subhead.text %}
    {% if subhead %}
      <h4>{{ subhead }}</h4>
    {% endif %}

    {# BODY #}
    {% set body = content.content.text %}
    {% if body %}
      <p>{{ body }}</p>
    {% endif %}

    {# BUTTONS #}
    {% set pb = content.buttons.primary_button|default({}) %}
    {% set sb = content.buttons.secondary_button|default({}) %}

    {% if pb.text|default('')|trim or sb.text|default('')|trim %}
      <div class="content-module module-buttons">
        {% if pb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               pb,
               'opkey-primary',
               path.to.button_design_preset_section,
               'primary',
               pb.text|trim
             ) }}
        {% endif %}
        {% if sb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               sb,
               'opkey-link-text',
               path.to.button_design_preset_section,
               'secondary',
               sb.text|trim
             ) }}
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{# ===== COLUMNS ===== #}

{# Design-time defaults (editor only) #}
{% set default_columns = [
  {
    icon: null,
    heading: "Lorem ipsum dolor sit",
    content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
    button: { text: "Learn more", url: "#" }
  },
  {
    icon: null,
    heading: "Lorem ipsum dolor sit",
    content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
    button: { text: "Learn more", url: "#" }
  },
  {
    icon: null,
    heading: "Lorem ipsum dolor sit",
    content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
    button: { text: "Learn more", url: "#" }
  },
  {
    icon: null,
    heading: "Lorem ipsum dolor sit",
    content: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
    button: { text: "Learn more", url: "#" }
  }
] %}

{# Determine source: real columns -> use them; otherwise show defaults ONLY in editor #}
{% set has_real_columns = (content.columns is defined and content.columns.column is defined and content.columns.column|length > 0) %}
{% if has_real_columns %}
  {% set columns = content.columns.column %}
{% elseif isEditor %}
  {% set columns = default_columns %}
{% else %}
  {% set columns = [] %}
{% endif %}

{# Common media defaults #}
{% set media_size = content.content.size|default('full') %}
{% set media_lazy = content.content.lazyLoad|default(true) %}

{# Count once for nav logic #}
{% set total_cards = columns|length %}

<div class="breakdance-swiper-wrapper" data-swiper-id="%%UNIQUESLUG%%">
  <div class="swiper swiper-%%UNIQUESLUG%%" data-card-count="{{ total_cards }}">
    <div class="swiper-wrapper">
      {% for item in columns %}
        {# Button logic:
           - real button when provided
           - placeholder only in editor when rendering defaults
           - none on frontend if not provided
        #}
        {% set has_real_btn = (item.button is defined and item.button.text|default('')|trim) %}
        {% if has_real_btn %}
          {% set button_obj = item.button %}
        {% elseif isEditor and not has_real_columns %}
          {% set button_obj = { text: 'Learn more', url: '#' } %}
        {% else %}
          {% set button_obj = null %}
        {% endif %}

        <div class="swiper-slide">
          <div class="card">
            {# ICON: show only if explicitly provided #}
            {% if item.icon %}
              <div class="icon">
                {{ macros.getMedia(item.icon, media_size, media_lazy) }}
              </div>
            {% endif %}

            <h3>{{ item.heading|default('') }}</h3>
            <p>{{ item.content|default('') }}</p>

            {% if button_obj %}
              <div class="content-module module-buttons">
                {{ macros.atomV1ButtonHtml(
                  button_obj,
                  'opkey-link-text',
                  path.to.button_design_preset_section,
                  'secondary',
                  button_obj.text
                ) }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  {# Show arrows only if there are more than 4 cards #}
  {% if total_cards > 8 %}
    <div class="slider-navigation">
      <button class="swiper-button-prev swiper-button-prev-%%UNIQUESLUG%% custom-nav-btn"></button>
      <div class="swiper-pagination swiper-pagination-%%UNIQUESLUG%%"></div>
      <button class="swiper-button-next swiper-button-next-%%UNIQUESLUG%% custom-nav-btn"></button>
    </div>
  {% else %}
    <div class="slider-navigation">
      <div class="swiper-pagination swiper-pagination-%%UNIQUESLUG%%"></div>
    </div>
  {% endif %}
</div>
