<div class="module-container">
  <div class="content-module module-text">
    {# EYEBROW #}
    {% set eyebrow = content.eyebrow.text %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}

    {# HEADING #}
    {% set heading = content.heading.text  %}
    {% if heading %}
      <h2>{{ heading }}</h2>
    {% endif %}

    {# SUBHEAD #}
    {% set subhead = content.subhead.text  %}
    {% if subhead %}
      <h4>{{ subhead }}</h4>
    {% endif %}

    {# BODY #}
    {% set body = content.content.text  %}
    {% if body %}
      {{ body }}
    {% endif %}

    {# BUTTONS #}
    {% set pb = content.buttons.primary_button|default({}) %}
    {% set sb = content.buttons.secondary_button|default({}) %}

    {% if pb.text|default('')|trim or sb.text|default('')|trim %}
      <div class="content-module module-buttons">
        {% if pb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               pb,
               'opkey-primary',
               path.to.button_design_preset_section,
               'primary',
               pb.text|trim
             ) }}
        {% endif %}
        {% if sb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               sb,
               'opkey-link-text',
               path.to.button_design_preset_section,
               'secondary',
               sb.text|trim
             ) }}
        {% endif %}
      </div>
    {% endif %}
  </div>
  {# MEDIA #}
  {% set media_type = content.media.image_video_or_animation %}
  {% if media_type == 'image' %}
    <div class="hero-module module-media">

      {# --- Normalize lazyLoad --- #}
      {% set lazyLoad = content.image.lazyLoad ?? false %}

      {# --- Detect legacy vs flat alt controls --- #}
      {% set hasLegacyAltObj = content.image.alt is iterable %}
      {% set altMode = hasLegacyAltObj
        ? content.image.alt.type|default('from_media_library')
        : content.image.alt|default('from_media_library') %}

      {% set customAlt = hasLegacyAltObj
        ? content.image.alt.customAlt|default('')
        : content.image.custom_alt|default('') %}

      {# --- Compute final alt --- #}
      {% set alt = '' %}
      {% if content.image.from == 'media_library' %}
        {% if altMode == 'decorative' %}
          {% set alt = '' %}
        {% elseif altMode == 'custom' %}
          {% set alt = customAlt %}
        {% else %}
          {# Inherit attachment alt; fall back to title/filename #}
          {% set m = content.image.media ?? {} %}
          {% set alt = m.alt
            |default(m.alt_text)
            |default(m.title)
            |default(m.filename)
            |default('') %}
        {% endif %}
      {% else %}
        {# URL source: use provided custom_alt; otherwise heading/subhead #}
        {% set alt = customAlt|default(heading|default(subhead|default(''))) %}
      {% endif %}

      {# --- Derive src/srcset/size from media library when available --- #}
      {% set m = content.image.media ?? {} %}
      {% set full = m.sizes['full'] ?? {} %}
      {% set src = full.url|default(m.url|default(content.image.url|default(''))) %}
      {% set width = full.width|default(m.width|default('')) %}
      {% set height = full.height|default(m.height|default('')) %}

      {% set srcsetParts = [] %}
      {% for k in ['thumbnail','medium','medium_large','large','1536x1536','2048x2048','full'] %}
        {% set s = m.sizes[k] ?? null %}
        {% if s and s.url %}
          {% set w = s.width|default('') %}
          {% set srcsetParts = srcsetParts|merge([ w ? (s.url ~ ' ' ~ w ~ 'w') : s.url ]) %}
        {% endif %}
      {% endfor %}
      {% set srcset = srcsetParts|join(', ') %}

      {# --- Render <img> (ensures alt attribute always present) --- #}
      {% if content.image.from == 'media_library' and src %}
        <img
          src="{{ src }}"
          {% if srcset %}srcset="{{ srcset }}"{% endif %}
          sizes="100vw"
          {% if width %}width="{{ width }}"{% endif %}
          {% if height %}height="{{ height }}"{% endif %}
          alt="{{ alt }}"
          class="breakdance-image-object"
          style="width:100%; height:auto;"
          {% if lazyLoad %}loading="lazy"{% endif %}
        />
      {% elseif content.image.from == 'url' and content.image.url %}
        <img
          src="{{ content.image.url }}"
          alt="{{ alt }}"
          class="breakdance-image-object"
          style="width:100%; height:auto;"
          {% if lazyLoad %}loading="lazy"{% endif %}
        />
      {% else %}
        <img
          src="/wp-content/plugins/opkey-elements/assets/Placeholder-620x620.svg"
          alt="Placeholder image"
          class="breakdance-image-object"
          style="width:100%; height:auto;"
        />
      {% endif %}

      {# DEBUG: temporarily uncomment to verify computed values in page source
      <!-- alt-debug: mode={{ altMode }}, from={{ content.image.from }}, alt={{ alt|e }} -->
      #}

    </div>
  {% elseif media_type == 'video' %}
    <div class="ee-video-container">

      {# YOUTUBE #}
      {% if content.video.video.provider == 'youtube' %}
        {% if content.youtube.loading_method != 'lightweight' or not content.video.video.videoId %}
          {% if content.youtube.privacy_mode %}
            {% set videoUrl = content.video.video.embedUrl | replace({'https://www.youtube.com/': 'https://www.youtube-nocookie.com/'}) %}
          {% else %}
            {% set videoUrl = content.video.video.embedUrl %}
          {% endif %}

          {% set isLazyLoad = content.youtube.loading_method != 'embed' and not isBuilder %}
          {% set srcAttribute = isLazyLoad ? 'data-src' : 'src' %}

          <iframe
            class="ee-video {{ isLazyLoad ? 'lozad' : '' }}"
            title="{{ content.video.title }}"
            {{ srcAttribute }}="{{ videoUrl }}{{ content.youtube.hide_player_controls ? '&controls=0' }}{{ content.youtube.autoplay ? '&autoplay=1' }}{{ content.youtube.mute ? '&mute=1' }}{{ not content.youtube.play_inline ? '&playsinline=0' }}{{ content.youtube.modest_branding ? '&modestbranding=1' }}{{ content.youtube.start_time ? '&start=' ~ content.youtube.start_time.number }}{{ content.youtube.end_time ? '&end=' ~ content.youtube.end_time.number }}{{ content.youtube.suggested_videos == 'recommendations' ? '' : '&rel=0' }}{{ content.youtube.loop and content.video.video.videoId ? '&playlist=' ~ content.video.video.videoId ~ '&loop=1' }}&enablejsapi=1"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen>
          </iframe>
        {% else %}
          {# lightweight YouTube embed #}
          {% set defaultMaxRes = 'https://i.ytimg.com/vi/' ~ content.video.video.videoId ~ '/maxresdefault.jpg' %}
          {% set customBackground = content.youtube.background_image.sizes["full"].url %}
          {% set logo = content.youtube.logo.sizes["full"].url %}

          <lite-youtube
            videoid="{{ content.video.video.videoId }}"
            style="background-image: url({{ customBackground|default(defaultMaxRes) }}); {{ logo ? '--logoUrl: url(' ~ logo ~')' : '' }}"
            class="ee-video"
            title="{{ content.youtube.title }}"
            params="{{ content.youtube.hide_player_controls ? 'controls=0' }}{{ content.youtube.mute ? '&mute=1' }}{{ not content.youtube.play_inline ? '&playsinline=0' }}{{ content.youtube.modest_branding ? '&modestbranding=1' }}{{ content.youtube.start_time ? '&start=' ~ content.youtube.start_time.number }}{{ content.youtube.end_time ? '&end=' ~ content.youtube.end_time.number }}{{ content.youtube.suggested_videos == 'recommendations' ? '' : '&rel=0' }}{{ content.youtube.loop and content.video.video.videoId ? '&playlist=' ~ content.video.video.videoId ~ '&loop=1' }}&enablejsapi=1">
          </lite-youtube>
        {% endif %}

      {# VIMEO #}
      {% elseif content.video.video.provider == 'vimeo' %}
        {% if content.vimeo.loading_method != 'lightweight' or not content.video.video.videoId %}
          {% set isLazyLoad = content.vimeo.loading_method != 'embed' and not isBuilder %}
          {% set srcAttribute = isLazyLoad ? 'data-src' : 'src' %}
          <div class="ee-video ee-vimeo">
            <iframe
              class="ee-video {{ isLazyLoad ? 'lozad' : '' }}"
              title="{{ content.video.title }}"
              {{ srcAttribute }}="{{ content.video.video.embedUrl }}{{ content.vimeo.autoplay ? '&autoplay=1' }}{{ content.vimeo.hide_player_controls ? '&controls=0' : '&controls=1' }}{{ content.vimeo.controls.color ? '&color=' ~ content.vimeo.controls.color | slice(1, 6) }}{{ content.vimeo.loop ? '&loop=1' }}{{ content.vimeo.mute ? '&muted=1' }}{{ not content.vimeo.play_inline ? '&playsinline=0' }}{{ content.vimeo.start_time ? '#t=' ~ content.vimeo.start_time.number }}"
              width="100%" height="100%" frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen>
            </iframe>
          </div>
        {% else %}
          {% set customBackground = content.vimeo.background_image.url %}
          {% if customBackground is not empty %}
            <div class="ee-vimeo-poster" style="background-image: url({{ customBackground }});background-size:cover;">
              <button class="ee-vimeo-play-button"></button>
            </div>
          {% else %}
            <lite-vimeo
              videoid="{{ content.video.video.videoId }}"
              {% if content.vimeo.start_time %}
                videoPlay="content.vimeo.start_time.style"
              {% endif %}
              class="ee-video">
            </lite-vimeo>
          {% endif %}
        {% endif %}

      {# DAILYMOTION #}
      {% elseif content.video.video.provider == 'dailymotion' %}
        {% set isLazyLoad = content.dailymotion.loading_method != 'embed' and not isBuilder %}
        {% set srcAttribute = isLazyLoad ? 'data-src' : 'src' %}
        <div class="ee-video ee-dailymotion">
          <iframe
            frameborder="0"
            width="100%" height="100%"
            class="ee-video {{ isLazyLoad ? 'lozad' : '' }}"
            {{ srcAttribute }}="{{ content.video.video.embedUrl }}{{ content.dailymotion.autoplay ? '&autoplay=1' }}{{ content.dailymotion.controls.hide_player_controls ? '&controls=0' : '&controls=1' }}{{ content.dailymotion.controls.color ? '&ui-highlight=' ~ content.dailymotion.controls.color | slice(1, 6) }}{{ content.dailymotion.controls.hide_logo ? '&ui-logo=0' }}{{ content.dailymotion.controls.hide_video_info ? '&ui-start-screen-info=0' }}{{ content.dailymotion.controls.disable_sharing ? '&sharing-enable=0' }}{{ content.dailymotion.mute ? '&mute=1' }}{{ content.dailymotion.start_time ? '&start=' ~ content.dailymotion.start_time.number }}&queue-autoplay-next=0"
            allowfullscreen
            allow="autoplay; fullscreen; picture-in-picture">
          </iframe>
        </div>
      {% endif %}

      {# Overlay, if enabled #}
      {% if design.container.overlay %}
        <div class="ee-video-overlay"></div>
      {% endif %}
    </div>
  {% elseif media_type == 'animation' %}
  {% set src = content.lottie.asset_url.url  %}
    <div class="content-module module-media">
      <div
        class="bde-lottie-animation bde-lottie-target lottie-wrapper"
        data-src="{{ src }}"
        data-speed="{{ content.lottie.animation_speed ?? 1 }}"
        data-loop="{{ content.lottie.loop_animation ? 'true' : 'false' }}"
        data-autoplay="true"
        data-renderer="{{ content.lottie.renderer ?? 'svg' }}"
      ></div>
    </div>
  {% endif %}
</div>