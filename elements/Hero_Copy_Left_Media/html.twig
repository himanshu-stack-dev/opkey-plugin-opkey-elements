<div class="module-container">
  <div class="hero-module module-text">
    {# EYEBROW #}
    {% set eyebrow = content.eyebrow.text %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}

    {# HEADING #}
    {% set heading = content.heading.text %}
    {% if heading %}
      <h1>{{ heading }}</h1>
    {% endif %}

    {# SUBHEAD #}
    {% set subhead = content.subhead.text %}
    {% if subhead %}
      <h2>{{ subhead }}</h2>
    {% endif %}

    {# BODY #}
    {% set body = content.content.text %}
    {% if body %}
      <p>{{ body }}</p>
    {% endif %}

    {# BUTTONS (normalize text to string first) #}
    {% set pb = content.buttons.primary_button|default({}) %}
    {% set sb = content.buttons.secondary_button|default({}) %}

    {# Robust string extraction helper pattern #}
    {% set pb_text = '' %}
    {% if pb.text is defined %}
      {% if pb.text is iterable %}
        {% set pb_text = (pb.text.text|default('')) ~ '' %}
      {% else %}
        {% set pb_text = (pb.text ~ '') %}
      {% endif %}
    {% endif %}

    {% set sb_text = '' %}
    {% if sb.text is defined %}
      {% if sb.text is iterable %}
        {% set sb_text = (sb.text.text|default('')) ~ '' %}
      {% else %}
        {% set sb_text = (sb.text ~ '') %}
      {% endif %}
    {% endif %}

    {% if pb_text|trim or sb_text|trim %}
      <div class="content-module module-buttons">
        {% if pb_text|trim %}
          {{ macros.atomV1ButtonHtml(
               pb,
               'opkey-primary',
               path.to.button_design_preset_section,
               'primary',
               pb_text|trim
             ) }}
        {% endif %}
        {% if sb_text|trim %}
          {{ macros.atomV1ButtonHtml(
               sb,
               'opkey-link-text',
               path.to.button_design_preset_section,
               'secondary',
               sb_text|trim
             ) }}
        {% endif %}
      </div>
    {% endif %}
  </div>

  {# MEDIA #}
  <div class="hero-module module-media">
    {# Safely pull the image object and its media field (may be object or string) #}
    {% set img_obj = content.image is defined and content.image ? content.image : {} %}
    {% set media   = img_obj.media is defined ? img_obj.media : null %}

    {# Resolve a usable URL without using "is string" #}
    {% set img_url = null %}
    {% if media is iterable and media.url is defined and media.url %}
      {% set img_url = media.url %}
    {% elseif media is not iterable and media %}
      {# media is likely a plain string URL #}
      {% set img_url = media %}
    {% endif %}

    {# Alt / size / lazy defaults (alt may be array; normalize) #}
    {% set alt_text = '' %}
    {% if img_obj.alt is defined %}
      {% if img_obj.alt is iterable %}
        {% set alt_text = (img_obj.alt.text|default('')) ~ '' %}
      {% else %}
        {% set alt_text = (img_obj.alt ~ '') %}
      {% endif %}
    {% endif %}
    {% set size = img_obj.size|default('full') %}
    {% set lazy = img_obj.lazyLoad is defined ? img_obj.lazyLoad : true %}

    {% if img_url %}
      {{ macros.image(media, size, alt_text|trim, lazy) }}
    {% else %}
      <img
        src="/wp-content/plugins/opkey-elements/assets/Placeholder-620x620.svg"
        alt=""
        role="presentation"
        class="breakdance-image-object"
        style="width:100%; height:auto;" />
    {% endif %}
  </div>
</div>
