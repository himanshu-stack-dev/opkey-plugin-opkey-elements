<div class="module-container">
  <div class="hero-module module-text">
    {# EYEBROW #}
    {% set eyebrow = content.eyebrow.text %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}

    {# HEADING #}
    {% set heading = content.heading.text  %}
    {% if heading %}
      <h1>{{ heading }}</h1>
    {% endif %}

    {# SUBHEAD #}
    {% set subhead = content.subhead.text  %}
    {% if subhead %}
      <h2>{{ subhead }}</h2>
    {% endif %}

    {# BODY #}
    {% set body = content.content.text  %}
    {% if body %}
      <p>{{ body }}</p>
    {% endif %}

    {# LIST TITLE #}
    {% set list_title = content.list_title  %}
    {% if list_title %}
      <h4>{{ list_title }}</h4>
    {% endif %}

    {# LIST #}
    {% set list_items = content.list_items  %}
    <ul>
      {% for item in list_items %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>

    {# BUTTONS #}
    {% set pb = content.buttons.primary_button|default({}) %}
    {% set sb = content.buttons.secondary_button|default({}) %}

    {% if pb.text|default('')|trim or sb.text|default('')|trim %}
      <div class="content-module module-buttons">
        {% if pb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               pb,
               'opkey-primary',
               path.to.button_design_preset_section,
               'primary',
               pb.text|trim
             ) }}
        {% endif %}
        {% if sb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               sb,
               'opkey-link-text',
               path.to.button_design_preset_section,
               'secondary',
               sb.text|trim
             ) }}
        {% endif %}
      </div>
    {% endif %}
  </div>

  {# FORM #}
  {% set form_embed = content.shortcode.full_shortcode  %}
  {% if form_embed %}
     <div class="module-form">
      %%SSR%%
	 </div>
  {% endif %}
</div>