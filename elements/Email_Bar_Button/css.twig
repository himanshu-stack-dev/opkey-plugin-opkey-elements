/* PADDING */
{% if design.remove_padding.remove_top and design.remove_padding.remove_bottom %}
  %%SELECTOR%% { padding-top: 0 !important; padding-bottom: 0 !important; }
{% elseif design.remove_padding.remove_top %}
  %%SELECTOR%% { padding-top: 0 !important; }
{% elseif design.remove_padding.remove_bottom %}
  %%SELECTOR%% { padding-bottom: 0 !important; }
{% endif %}

/* THEME BACKGROUND */
{% if design.theme_color.color == 'purple' %}
  %%SELECTOR%% { background: #190D2C; color: #fff; }
{% elseif design.theme_color.color == 'light-gray' %}
  %%SELECTOR%% { background: #EDF7F9; }
{% elseif design.theme_color.color == 'white' or not design.theme_color.color %}
  %%SELECTOR%% { background: transparent; }
{% endif %}

/* EMAIL BAR LAYOUT */
%%SELECTOR%% .emailbar-inner {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

%%SELECTOR%% .emailbar-form {
  flex: 1 1 auto;
}

/* Apply width control to the form wrapper when set */
{% if design.email_bar.width.style %}
  %%SELECTOR%% .emailbar-form {
    max-width: {{ design.email_bar.width.style }};
  }
{% endif %}

/* INPUT STYLING (HUBSPOT / GENERIC) */
%%SELECTOR%% .emailbar-form input[type="email"],
%%SELECTOR%% .emailbar-form .hs-input,
%%SELECTOR%% .emailbar-form input[type="text"] {
  width: 100%;
  border: 1px solid {{ design.email_bar.border_color|default('rgba(15, 23, 42, 0.08)') }};
  background: {{ design.email_bar.background_color|default('#FFFFFF') }};
  color: {{ design.email_bar.text_color|default('#111827') }};
  padding:
    {{ design.email_bar.padding_y.style|default('12px') }}
    {{ design.email_bar.padding_x.style|default('20px') }};
  font-size: 14px;
  line-height: 1.4;
  outline: none;
}

{% set radiusType = design.email_bar.radius_type|default('round') %}
%%SELECTOR%% .emailbar-form input[type="email"],
%%SELECTOR%% .emailbar-form .hs-input,
%%SELECTOR%% .emailbar-form input[type="text"] {
  {% if radiusType == 'round' %}
    border-radius: 999px;
  {% elseif radiusType == 'square' %}
    border-radius: 6px;
  {% elseif radiusType == 'custom' and design.email_bar.radius_custom.style %}
    border-radius: {{ design.email_bar.radius_custom.style }};
  {% else %}
    border-radius: 999px;
  {% endif %}
}

/* PLACEHOLDER COLOR */
%%SELECTOR%% .emailbar-form input::placeholder,
%%SELECTOR%% .emailbar-form .hs-input::placeholder {
  color: {{ design.email_bar.placeholder_color|default('rgba(148, 163, 184, 1)') }};
}

