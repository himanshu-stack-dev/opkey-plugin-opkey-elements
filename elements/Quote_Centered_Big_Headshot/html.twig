{% set defaults = {
  eyebrow: 'LOREM IPSUM DOLOR',
  heading: 'Lorem ipsum dolor sit amet',
  subhead: 'Lorem ipsum dolor sit amet consectetur adipiscing elit',
  buttons: {
    primary: { text: 'Contact sales', url: '#' },
    secondary: { text: 'Learn more', url: '#' }
  },
  quote: {
    text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.',
    headshot: '/wp-content/uploads/2025/07/Placeholder_headshot_big.png',
    name: 'Lorem Dolor',
    company: 'Lorem ipsum, Company',
    button: { text: 'Learn more', url: '#' }
  }
} %}

<div class="module-container">
  <div class="module-text">
    {# EYEBROW #}
    {% set eyebrow = content.eyebrow.text | default(defaults.eyebrow) %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}

    {# HEADING #}
    {% set heading = content.heading.text | default(defaults.heading) %}
    {% if heading %}
      <h2>{{ heading }}</h2>
    {% endif %}

    {# SUBHEAD #}
    {% set subhead = content.subhead.text | default(defaults.subhead) %}
    {% if subhead %}
      <h4>{{ subhead }}</h4>
    {% endif %}

    {# BUTTONS #}
    {% set remove_buttons = content.buttons.remove_ is defined and content.buttons.remove_ == true %}
    {% if not remove_buttons %}
      {% set primary_button = (content.buttons.primary_button.text is defined and content.buttons.primary_button.text) 
          ? content.buttons.primary_button.text 
          : defaults.buttons.primary.text %}
      {% set primary_button_obj = (content.buttons.primary_button is defined and content.buttons.primary_button) 
          ? content.buttons.primary_button 
          : defaults.buttons.primary %}

      {% set has_secondary = content.buttons.secondary_button is defined and content.buttons.secondary_button.text is defined %}
      {% set secondary_button_obj = has_secondary ? content.buttons.secondary_button : defaults.buttons.secondary %}
      {% set secondary_button_label = secondary_button_obj.text ?? defaults.buttons.secondary.text %}

      {% if primary_button or secondary_button_label %}
        <div class="content-module module-buttons">
          {% if primary_button %}
            {{ macros.atomV1ButtonHtml(primary_button_obj, 'opkey-primary', path.to.button_design_preset_section, 'primary', primary_button) }}
          {% endif %}
          {% if secondary_button_label %}
            {{ macros.atomV1ButtonHtml(secondary_button_obj, 'opkey-link-text', path.to.button_design_preset_section, 'secondary', secondary_button_label) }}
          {% endif %}
        </div>
      {% endif %}
    {% endif %}
  </div>
  <div class="module-quote">
    <div class="quote-content">
      <div class="gradient-wrapper">
        <div class="breakdance-swiper-wrapper" data-swiper-id="%%ID%%">
          <div class="swiper swiper-%%UNIQUESLUG%%">
            <div class="swiper-wrapper">
              {% set slides = (content.quotes.slides is defined and content.quotes.slides|length > 0) 
                  ? content.quotes.slides 
                  : [defaults.quote] %}
              {% for item in slides %}
                <div class="swiper-slide">
                  <div class="bde-basicslider__slide">
                    <div>
                      <div class="bde-basicslider__content">
                        <div class="bde-basicslider__text">
                          {{ item.text|default(defaults.quote.text) }}
                          <div class="name-company">
                            <div class="name">{{ item.name|default(defaults.quote.name) }}</div>
                            <div class="company">{{ item.role_company|default(defaults.quote.company) }}</div>
                          </div>
                        </div>
                        <div class="quote-attribution">
                          <div class="headshot">
                            {% if item.headshot is defined and item.headshot is not empty 
                                  and (item.headshot.url is defined or item.headshot.ID is defined or item.headshot.id is defined) %}
                              {{ macros.image(item.headshot, content.content.size, alt|default('Placeholder headshot'), lazyLoad) }}
                            {% else %}
                              <img src="{{ defaults.quote.headshot }}" alt="Placeholder headshot" loading="lazy">
                            {% endif %}
                          </div>
                          <div class="name-company mobile">
                            <div class="name">{{ item.name|default(defaults.quote.name) }}</div>
                            <div class="company">{{ item.role_company|default(defaults.quote.company) }}</div>
                          </div>
                        </div>
                      </div>
                      <div style="display:flex;">
                        {# Only render button if text is present, fallback to default #}
                        {% set btn_text = item.button is defined and item.button.text is defined and item.button.text
                          ? item.button.text
                          : defaults.quote.button.text %}
                        {% set btn_url = item.button is defined and item.button.url is defined and item.button.url
                          ? item.button.url
                          : defaults.quote.button.url %}
                        {% if btn_text %}
                          {{ macros.atomV1ButtonHtml(
                            { text: btn_text, url: btn_url },
                            'bde-basicslider__button opkey-link-text',
                            design.button,
                            'content.quotes.slides[' ~ loop.index0 ~ '].button.text'
                          ) }}
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="slider-navigation">
      <button class="swiper-button-prev swiper-button-prev-%%UNIQUESLUG%% custom-nav-btn"></button>
      <div class="swiper-pagination swiper-pagination-%%UNIQUESLUG%%"></div>
      <button class="swiper-button-next swiper-button-next-%%UNIQUESLUG%% custom-nav-btn"></button>
    </div>
  </div>
</div>