{% set defaults = {
  quote: {
    title: 'Lorem ipsum dolor sit amet consectetur adipiscing elit',
    text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
    headshot: '/wp-content/uploads/2025/07/Placeholder_headshot.png',
    name: 'Lorem Dolor',
    role_company: 'Lorem ipsum, Company',
    button: { text: 'Learn more', url: '#' }
  }
} %}

<div class="module-container">
  <div class="module-text">
    {% set eyebrow = content.eyebrow.text %}
    {% if eyebrow %}<div class="eyebrow">{{ eyebrow }}</div>{% endif %}

    {% set heading = content.heading.text %}
    {% if heading %}<h2>{{ heading }}</h2>{% endif %}

    {% set subhead = content.subhead.text %}
    {% if subhead %}<h4>{{ subhead }}</h4>{% endif %}

    {% set pb = content.buttons.primary_button|default({}) %}
    {% set sb = content.buttons.secondary_button|default({}) %}

    {% if pb.text|default('')|trim or sb.text|default('')|trim %}
      <div class="content-module module-buttons">
        {% if pb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(pb,'opkey-primary',path.to.button_design_preset_section,'primary',pb.text|trim) }}
        {% endif %}
        {% if sb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(sb,'opkey-link-text',path.to.button_design_preset_section,'secondary',sb.text|trim) }}
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="module-quote">
    <div class="quote-content">
      <div class="gradient-wrapper">
        <div class="breakdance-swiper-wrapper" data-swiper-id="%%ID%%">
          <div class="swiper swiper-%%UNIQUESLUG%%">
            <div class="swiper-wrapper">
              {% set slides = (content.quotes.slides is defined and content.quotes.slides|length > 0) ? content.quotes.slides : [defaults.quote] %}

              {% for item in slides %}
                {% set is_fallback = item.text|default('') == defaults.quote.text %}

                {# the raw link control as saved in the repeater #}
                {% set raw_link = item.link_to_case_study|default({}) %}

                {# Build a proper Breakdance link-control object for fallback #}
                {% set fallback_link = {
                  text: defaults.quote.button.text,
                  link: { url: defaults.quote.button.url, new_window: false, nofollow: false }
                } %}

                {# Use raw repeater link when present; else fallback #}
                {% set linkObj = is_fallback ? fallback_link : raw_link %}

                {# Derive a label (macro's 5th arg) #}
                {% set label = linkObj.text|default('Learn more')|trim %}

                <div class="swiper-slide">
                  <div class="bde-basicslider__slide">
                    <div class="bde-basicslider__content">
                      <h4 class="bde-basicslider__title">{{ item.title }}</h4>
                      <div class="bde-basicslider__text">{{ item.text }}</div>

                      <div class="quote-attribution">
                        <div class="headshot">
                          {% if item.headshot is defined and item.headshot is not empty and (item.headshot.url is defined or item.headshot.ID is defined or item.headshot.id is defined) %}
                            {{ macros.image(item.headshot, content.content.size, alt, lazyLoad) }}
                          {% else %}
                            <img src="{{ defaults.quote.headshot }}" alt="Placeholder headshot" loading="lazy">
                          {% endif %}
                        </div>
                        <div class="name-company">
                          <div class="name">{{ item.name }}</div>
                          <div class="company">{{ item.role_company }}</div>
                        </div>
                      </div>

                      {% if label %}
                        {{ macros.atomV1ButtonHtml(
                          linkObj,
                          'bde-basicslider__button opkey-link-text',
                          path.to.button_design_preset_section,
                          'text',
                          label
                        ) }}
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="slider-navigation">
      <button class="swiper-button-prev swiper-button-prev-%%UNIQUESLUG%% custom-nav-btn"></button>
      <div class="swiper-pagination swiper-pagination-%%UNIQUESLUG%%"></div>
      <button class="swiper-button-next swiper-button-next-%%UNIQUESLUG%% custom-nav-btn"></button>
    </div>
  </div>
</div>
