<div class="module-container">
  <div class="module-text">
    {# EYEBROW #}
    {% set eyebrow = content.eyebrow.text | default('LOREM IPSUM DOLOR') %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}
    {# HEADING #}
    {% set heading = content.heading.text | default('Lorem ipsum dolor sit amet') %}
    {% if heading %}
      <h2>{{ heading }}</h2>
    {% endif %}
    {# BODY #}
    {% set body = content.content.text | default('Lorem ipsum dolor sit amet consectetur adipiscing elit.') %}
    {% if body %}
      <p>{{ body }}</p>
    {% endif %}

    {# BUTTONS #}
    {% set remove_buttons = content.buttons.remove_ is defined and content.buttons.remove_ == true %}

    {% if not remove_buttons %}
      {% set primary_button = content.buttons.primary_button.text ?? 'Contact sales' %}
      {% set has_secondary = content.buttons.secondary_button is defined and content.buttons.secondary_button.text is defined %}
      {% set secondary_button_obj = has_secondary ? content.buttons.secondary_button : { text: 'Learn more', url: '#' } %}
      {% set secondary_button_label = secondary_button_obj.text ?? 'Learn more' %}

      {% if primary_button or secondary_button_label %}
        <div class="content-module module-buttons">
          {% if primary_button %}
            {{ macros.atomV1ButtonHtml(content.buttons.primary_button, 'opkey-primary', path.to.button_design_preset_section, 'primary', primary_button) }}
          {% endif %}
          {% if secondary_button_label %}
            {{ macros.atomV1ButtonHtml(secondary_button_obj, 'opkey-link-text', path.to.button_design_preset_section, 'secondary', secondary_button_label) }}
          {% endif %}
        </div>
      {% endif %}
    {% endif %}
  </div>
  <div class="module-quote">
    <div class="quote-content">
      <div class="gradient-wrapper">
        <div class="breakdance-swiper-wrapper" data-swiper-id="%%ID%%">
          <div class="swiper swiper-%%UNIQUESLUG%%">
            <div class="swiper-wrapper">
              {% if content.content.slides and content.content.slides|length > 0 %}
                {% for item in content.content.slides %}
                  <div class="swiper-slide">
                    <div class="bde-basicslider__slide">
                      <div class="bde-basicslider__content">
                        <{{content.content.title_html_tag|default('h4')}} class="bde-basicslider__title">
                          {{ item.title|default('Lorem ipsum dolor sit amet consectetur adipiscing elit') }}
                        </{{content.content.title_html_tag|default('h4')}}>
                        <div class="bde-basicslider__text">
                          {{ item.text|default('Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.') }}
                        </div>
                        <div class="quote-attribution">
                          <div class="headshot">
                            {% if item.headshot is not empty %}
                              {{ macros.image(item.headshot, content.content.size, alt|default('Placeholder headshot'), lazyLoad) }}
                            {% else %}
                              <img src="/wp-content/uploads/2025/07/Placeholder_headshot.png" alt="Placeholder headshot" loading="lazy">
                            {% endif %}
                          </div>
                          <div class="name-company">
                            <div class="name">{{ item.name|default('Lorem Dolor') }}</div>
                            <div class="company">{{ item.role_company|default('Lorem ipsum, Company') }}</div>
                          </div>
                        </div>
                        {% if item.button.text or true %}
                          {{ macros.atomV1ButtonHtml(
                            {
                              text: item.button.text|default('Learn more'),
                              url: item.button.url|default('#')
                            },
                            'bde-basicslider__button opkey-link-text',
                            design.button,
                            'content.content.slides[' ~ loop.index0 ~ '].button.text'
                          ) }}
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endfor %}
              {% else %}
                <div class="swiper-slide">
                  <div class="bde-basicslider__slide">
                    <div class="bde-basicslider__content">
                      <h4 class="bde-basicslider__title">Lorem ipsum dolor sit amet consectetur adipiscing elit</h4>
                      <div class="bde-basicslider__text">
                        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
                      </div>
                      <div class="quote-attribution">
                        <div class="headshot">
                          <img src="/wp-content/uploads/2025/07/Placeholder_headshot.png" alt="Placeholder headshot" loading="lazy">
                        </div>
                        <div class="name-company">
                          <div class="name">Lorem Dolor</div>
                          <div class="company">Lorem ipsum, Company</div>
                        </div>
                      </div>
                      {{ macros.atomV1ButtonHtml(
                        {
                          text: 'Learn more',
                          url: '#'
                        },
                        'bde-basicslider__button opkey-link-text',
                        design.button,
                        'content.content.slides[0].button.text'
                      ) }}
                    </div>
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="slider-navigation">
      <button class="swiper-button-prev swiper-button-prev-%%UNIQUESLUG%% custom-nav-btn"></button>
      <div class="swiper-pagination swiper-pagination-%%UNIQUESLUG%%"></div>
      <button class="swiper-button-next swiper-button-next-%%UNIQUESLUG%% custom-nav-btn"></button>
    </div>
  </div>
</div>