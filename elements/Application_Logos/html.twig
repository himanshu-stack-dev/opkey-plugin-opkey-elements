<div class="module-container">
  <div class="module-top-nav-accordion module-text">
    {# EYEBROW #}
    {% set eyebrow = content.eyebrow.text %}
    {% if eyebrow %}
      <div class="eyebrow">{{ eyebrow }}</div>
    {% endif %}

    {# HEADING #}
    {% set heading = content.heading.text %}
    {% if heading %}
      <h2>{{ heading }}</h2>
    {% endif %}

    {# SUBHEAD #}
    {% set subhead = content.subhead.text %}
    {% if subhead %}
      <h4>{{ subhead }}</h4>
    {% endif %}

    {# BODY #}
    {% set body = content.content.text %}
    {% if body %}
      <p>{{ body }}</p>
    {% endif %}
  </div>

  <div class="logo-grid">
  <div class="module-text">
    {# SUPPORTING COPY #}
    <p>{{ content.support_copy.text }}</p>

    {# BUTTONS #}
    {% set pb = content.buttons.primary_button|default({}) %}
    {% set sb = content.buttons.secondary_button|default({}) %}

    {% if pb.text|default('')|trim or sb.text|default('')|trim %}
      <div class="content-module module-buttons">
        {% if pb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               pb,
               'opkey-primary',
               path.to.button_design_preset_section,
               'primary',
               pb.text|trim
             ) }}
        {% endif %}
        {% if sb.text|default('')|trim %}
          {{ macros.atomV1ButtonHtml(
               sb,
               'opkey-link-text',
               path.to.button_design_preset_section,
               'secondary',
               sb.text|trim
             ) }}
        {% endif %}
      </div>
    {% endif %}
  </div>

    {# Placeholder/fallback logos #}
    {% set logos = [
      '/wp-content/uploads/2025/07/Placeholder_180x120.png',
      '/wp-content/uploads/2025/07/Placeholder_180x120.png',
      '/wp-content/uploads/2025/07/Placeholder_180x120.png',
      '/wp-content/uploads/2025/07/Placeholder_180x120.png',
      '/wp-content/uploads/2025/07/Placeholder_180x120.png',
      '/wp-content/uploads/2025/07/Placeholder_180x120.png'
    ] %}

    <div class="un-static-image-grid">
      {% if content.logos.logos is defined and content.logos.logos|length > 0 %}
        {% for item in content.logos.logos %}
          {% if item.link %}
            {{ macros.linkStart(item.link, 'un-logo-bar__logo-wrapper') }}
              {{ macros.image(item.image, item.size, item.alt, false) }}
            {{ macros.linkEnd() }}
          {% else %}
            <div class="un-logo-bar__logo-wrapper">
              {{ macros.image(item.image, item.size, item.alt, false) }}
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        {% for logo in logos %}
          <div class="un-logo-bar__logo-wrapper">
            <img src="{{ logo }}" alt="">
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>